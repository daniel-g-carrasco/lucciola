         iconColor = colorForRole(ColorRole::OnPrimary);
       } else if (isSelected) {
-        rowFill = colorForRole(ColorRole::Primary, 0.16f);
-        labelColor = colorForRole(ColorRole::Primary);
+        rowFill = colorForRole(ColorRole::Secondary, 0.16f);
