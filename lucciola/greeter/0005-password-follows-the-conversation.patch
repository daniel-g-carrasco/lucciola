+void GreeterSurface::handOverPasswordTo(GreeterSurface& other) {
+  if (&other == this) {
+    return;
+  }
+  other.m_password = std::move(m_password);
+  if (other.m_passwordField != nullptr) {
+    other.m_passwordField->setValue(other.m_password);
+  }
+  clearPasswordInput();
+  other.commitImmediateFrame(false);
+}
