 void Greeter::setActiveSurface(GreeterSurface* surface) {
+  // start_on_select keeps a conversation open while idle: it follows the
+  // output in use, so typing there reaches it.
+  if (m_startOnSelect && surface != nullptr && m_authSurface != nullptr && m_authSurface != surface) {
+    moveAuthTo(surface);
+  }
   m_activeSurface = surface;
   for (auto& view : m_views) {
     view.surface->setKeyboardOwner(view.surface.get() == surface);
   }
 }
 
+void Greeter::moveAuthTo(GreeterSurface* heir) {
+  if (heir == nullptr || m_authSurface == nullptr || heir == m_authSurface) {
+    return;
+  }
+  kLog.info("greetd conversation moves to another output's surface");
+  m_authSurface->handOverAuthTo(*heir);
+  m_authSurface = heir;
+  for (auto& view : m_views) {
+    if (view.surface) {
+      view.surface->setSharedAuthBlocked(view.surface.get() != heir);
+    }
+  }
+}
+
+void Greeter::driveStartOnSelect() {
+  if (m_orphanAuthSurface != nullptr && m_authSurface != m_orphanAuthSurface.get()) {
+    m_orphanAuthSurface.reset(); // its conversation ended or moved on
+  }
+  if (m_greetdUnavailable || m_views.empty()) {
+    return;
+  }
+  GreeterSurface* active = m_activeSurface != nullptr ? m_activeSurface : m_views.front().surface.get();
+  if (m_authSurface != nullptr) {
+    m_authSurface->cancelStaleAuth();
+  } else {
+    active->startAuthOnSelect();
+  }
+  const GreeterSurface* source = m_authSurface != nullptr ? m_authSurface : active;
+  for (auto& view : m_views) {
+    view.surface->mirrorStatusFrom(*source);
+  }
+}
