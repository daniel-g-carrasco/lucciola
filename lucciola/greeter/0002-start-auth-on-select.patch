+
+void GreeterSurface::startAuthOnSelect() {
+  if (!m_startOnSelect || m_greetdClient == nullptr || !m_greetdClient->isConnected() || m_greetdUnavailable
+      || m_sharedAuthBlocked || m_authSessionStarted || awaitingReply() || !m_passwordVisible || m_username.empty()
+      || m_autoStartHeldFor == m_username) {
+    return;
+  }
+  if (m_onAuthBeginRequested && !m_onAuthBeginRequested(this)) {
+    return;
+  }
+  // A password submitted while the previous conversation was being cancelled
+  // (user switch) stays armed for this one.
+  m_authenticating = m_hasPendingResponse;
+  m_userAnswered = m_hasPendingResponse;
+  m_secretPromptWaiting = false;
+  m_fingerOffered = false;
+  m_authUser = m_username;
+  kLog.info("greetd: create_session for '{}' (start_on_select)", m_username);
+  if (!m_greetdClient->requestCreateSession(m_username)) {
+    reportGreetdTransportError(
+        m_greetdClient->lastError().value_or(GreetdError{GreetdErrorType::Error, "failed to send request"})
+    );
+    return;
+  }
+  m_authSessionStarted = true;
+  m_pendingReplies.push_back(AuthRequest::CreateSession);
+  syncAuthInteractivity();
+  commitImmediateFrame(false);
+}
+
+bool GreeterSurface::startOnSelectSubmit() {
+  // A submit while the conversation start_on_select opened is running, and
+  // the user has not submitted yet. Anything else takes the usual path.
+  if (!m_authSessionStarted || m_authenticating || m_greetdClient == nullptr || m_greetdUnavailable
+      || m_sharedAuthBlocked || startSessionPending()) {
+    return false;
+  }
+  if (m_secretPromptWaiting && !m_cancelWanted) {
+    if (!m_password.empty()) {
+      m_authenticating = true;
+      m_userAnswered = true;
+      m_carryError.clear();
+      postAuthResponse(m_password);
+      return true;
+    }
+    // An empty submit at the password prompt starts over: a new
+    // conversation, so the fingerprint reader listens again.
+    kLog.info("greetd: empty submit at the password prompt, starting the conversation again");
+    m_secretPromptWaiting = false;
+    m_autoStartHeldFor.clear();
+    m_carryError.clear();
+    updateStatus("", false);
+    if (!resetAuthSession()) {
+      return true;
+    }
+    syncAuthInteractivity();
+    commitImmediateFrame(false);
+    return true;
+  }
+  if (m_password.empty()) {
+    return true; // PAM is waiting for something else (a finger): nothing to keep
+  }
+  // PAM is busy, typically pam_fprintd waiting for a finger. greetd reads one
+  // request at a time, so neither an answer nor a cancel reaches PAM before
+  // that module gives up; keep the password for the prompt that follows.
+  m_pendingResponse = m_password;
+  m_hasPendingResponse = true;
+  m_authenticating = true;
+  m_userAnswered = true;
+  m_carryError.clear();
+  // The status line is one line: short texts.
+  updateStatus(
+      m_fingerOffered ? "Password kept: sent when the reader stops waiting" : "Password kept for the password prompt",
+      false
+  );
+  syncAuthInteractivity();
+  commitImmediateFrame(false);
+  return true;
+}
+
+void GreeterSurface::cancelStaleAuth() {
+  if (!m_startOnSelect || !m_authSessionStarted || m_cancelWanted || startSessionPending()) {
+    return;
+  }
+  if (m_passwordVisible && m_authUser == m_username) {
+    return;
+  }
+  kLog.info("greetd: selection changed, cancelling the conversation for '{}'", m_authUser);
+  m_authenticating = false;
+  m_secretPromptWaiting = false;
+  m_hasPendingResponse = false;
+  m_pendingResponse.clear();
+  m_carryError.clear();
+  if (awaitingReply()) {
+    // greetd answers this request first (the fingerprint reader may hold it
+    // for a while); the cancel follows in handleGreetdResponse().
+    m_cancelWanted = true;
+    syncAuthInteractivity();
+    return;
+  }
+  if (!resetAuthSession()) {
+    return;
+  }
+  syncAuthInteractivity();
+  commitImmediateFrame(false);
+}
+
+void GreeterSurface::handOverAuthTo(GreeterSurface& other) {
+  if (&other == this) {
+    return;
+  }
+  other.m_authenticating = m_authenticating;
+  other.m_authSessionStarted = m_authSessionStarted;
+  other.m_secretPromptWaiting = m_secretPromptWaiting;
+  other.m_hasPendingResponse = m_hasPendingResponse;
+  other.m_pendingResponse = std::move(m_pendingResponse);
+  other.m_pendingReplies = std::move(m_pendingReplies);
+  other.m_authUser = m_authUser;
+  other.m_userAnswered = m_userAnswered;
+  other.m_autoStartHeldFor = m_autoStartHeldFor;
+  other.m_cancelWanted = m_cancelWanted;
+  other.m_fingerOffered = m_fingerOffered;
+  other.m_carryError = m_carryError;
+  other.updateStatus(m_status, m_statusIsError);
+
+  m_authenticating = false;
+  m_authSessionStarted = false;
+  m_secretPromptWaiting = false;
+  m_hasPendingResponse = false;
+  m_pendingResponse.clear();
+  m_pendingReplies.clear();
+  m_userAnswered = false;
+  m_cancelWanted = false;
+  m_carryError.clear();
+  syncAuthInteractivity();
+  other.syncAuthInteractivity();
+  other.commitImmediateFrame(false);
+}
+
+void GreeterSurface::mirrorStatusFrom(const GreeterSurface& other) {
+  if (&other == this || (m_status == other.m_status && m_statusIsError == other.m_statusIsError)) {
+    return;
+  }
+  updateStatus(other.m_status, other.m_statusIsError);
+}
