   m_authUser = m_username;
   kLog.info("greetd: create_session for '{}' (start_on_select)", m_username);
   if (!m_greetdClient->requestCreateSession(m_username)) {
@@ -1579,6 +1626,7 @@ void GreeterSurface::handOverAuthTo(GreeterSurface& other) {
   other.m_autoStartHeldFor = m_autoStartHeldFor;
   other.m_cancelWanted = m_cancelWanted;
   other.m_fingerOffered = m_fingerOffered;
+  other.m_pamSpoke = m_pamSpoke;
   other.m_carryError = m_carryError;
   other.updateStatus(m_status, m_statusIsError);
 
@@ -1700,6 +1748,7 @@ void GreeterSurface::handleAuthMessage(const GreetdAuthMessage& message) {
       m_fingerOffered = true;
     }
     if (!message.message.empty()) {
+      m_pamSpoke = true;
       if (m_startOnSelect && !m_carryError.empty()) {
         // Why the last attempt failed stays; the status line is one line,
         // so the new prompt is only a short "or the fingerprint" next to it.
@@ -1747,6 +1796,12 @@ void GreeterSurface::handleAuthMessage(const GreetdAuthMessage& message) {
     m_carryError.clear();
   } else if (m_startOnSelect && m_fingerOffered && message.type == GreetdAuthMessageType::Secret) {
     updateStatus("Type the password, or Enter for the fingerprint", false);
+  } else if (message.type == GreetdAuthMessageType::Secret && isGenericPasswordPrompt(message.message)) {
+    // The field's placeholder already asks for the password. What this
+    // conversation's PAM said before stays; anything older goes.
+    if (!m_pamSpoke) {
+      updateStatus("", false);
+    }
   } else if (!message.message.empty()) {
     updateStatus(message.message, false);
   }
