+// Lucciola: the brightness keys work on the login screen too. The new value
+// goes through logind (SetBrightness on the greeter's own session), the way
+// a desktop session changes it without root, with systemd's busctl: no new
+// library, no shell. Steps of 5%, never below 1% so the screen stays lit.
+static long read_backlight_value(const char* device, const char* file) {
+  char path[512];
+  snprintf(path, sizeof(path), "/sys/class/backlight/%s/%s", device, file);
+  FILE* fp = fopen(path, "r");
+  if (fp == NULL) {
+    return -1;
+  }
+  long value = -1;
+  if (fscanf(fp, "%ld", &value) != 1) {
+    value = -1;
+  }
+  fclose(fp);
+  return value;
+}
+
+static int backlight_rank(const char* device) {
+  char path[512];
+  char type[32] = "";
+  snprintf(path, sizeof(path), "/sys/class/backlight/%s/type", device);
+  FILE* fp = fopen(path, "r");
+  if (fp != NULL) {
+    if (fscanf(fp, "%31s", type) != 1) {
+      type[0] = '\0';
+    }
+    fclose(fp);
+  }
+  // The kernel's own order of preference for the panel's backlight.
+  if (strcmp(type, "firmware") == 0) {
+    return 3;
+  }
+  if (strcmp(type, "platform") == 0) {
+    return 2;
+  }
+  if (strcmp(type, "raw") == 0) {
+    return 1;
+  }
+  return 0;
+}
+
+static void step_backlight(int direction) {
+  DIR* dir = opendir("/sys/class/backlight");
+  if (dir == NULL) {
+    return;
+  }
+  char device[256] = "";
+  int best = -1;
+  struct dirent* entry;
+  while ((entry = readdir(dir)) != NULL) {
+    if (entry->d_name[0] == '.') {
+      continue;
+    }
+    int rank = backlight_rank(entry->d_name);
+    if (rank > best) {
+      best = rank;
+      snprintf(device, sizeof(device), "%s", entry->d_name);
+    }
+  }
+  closedir(dir);
+  if (device[0] == '\0') {
+    return;
+  }
+  long current = read_backlight_value(device, "brightness");
+  long max = read_backlight_value(device, "max_brightness");
+  if (current < 0 || max <= 0) {
+    return;
+  }
+  long step = max / 20 > 0 ? max / 20 : 1;
+  long floor = max / 100 > 0 ? max / 100 : 1;
+  long next = current + direction * step;
+  if (next < floor) {
+    next = floor;
+  }
+  if (next > max) {
+    next = max;
+  }
+  if (next == current) {
+    return;
+  }
+  char value[32];
+  snprintf(value, sizeof(value), "%ld", next);
+  // A grandchild runs busctl, so the compositor never waits on it.
+  pid_t child = fork();
+  if (child == 0) {
+    if (fork() == 0) {
+      execl("/usr/bin/busctl", "busctl", "call", "org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
+            "org.freedesktop.login1.Session", "SetBrightness", "ssu", "backlight", device, value, (char*)NULL);
+      _exit(127);
+    }
+    _exit(0);
+  }
+  if (child > 0) {
+    waitpid(child, NULL, 0);
+  }
+}
