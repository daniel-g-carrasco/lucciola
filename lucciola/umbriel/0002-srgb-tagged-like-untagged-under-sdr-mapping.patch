 .../checks/protocol/color_profile_srgb.sh     | 17 +++++-----
 .../protocol/color_profile_srgb_tagged.sh     | 34 +++++++++++++++++++
 .../protocol/color_profile_srgb_transfer.sh   | 28 +++++++++++++++
 umbrielfx/include/umbrielfx/render/pass.h     |  3 ++
 umbrielfx/render/fx_renderer/fx_pass.c        | 11 +++++-
 6 files changed, 85 insertions(+), 10 deletions(-)
 create mode 100755 tests/harness/checks/protocol/color_profile_srgb_tagged.sh
 create mode 100755 tests/harness/checks/protocol/color_profile_srgb_transfer.sh

