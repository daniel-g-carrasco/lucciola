#!/usr/bin/python3
"""Lucciola: per-monitor bar layout for Noctalia.

1. Fixed bar width on large screens. Noctalia sizes the bar with margins
   from the screen ends (margin_ends), not with a width, so the same margins
   that look right on a laptop stretch the bar across a large monitor. For
   every output wider than WIDE_ABOVE logical pixels the bar is kept
   BAR_WIDTH wide, centred.
2. One workspace on secondary screens, as in GNOME. The primary screen is
   the one holding the named workspace "1"; with more than one screen, the
   others get a bar without the workspace indicator (the Super+1 and
   Super+2 workspaces live on the primary). Unplug the primary and its
   workspaces move to the remaining screen, which becomes primary again.

3. The lock screen arranged like the login screen, on every monitor: Noctalia
   places lock screen widgets per output and in logical pixels, and the account
   picture and the name belong to the user, so a fragment in the image cannot
   say them (31-lucciola-lock.toml; 24-lock-screen.toml has the rest).

The overrides go to Noctalia's config folder (30-lucciola-monitors.toml),
and Noctalia is asked to reload when they change. niri announces no monitor
events, but plugging or unplugging a monitor always changes the workspaces,
so everything is recomputed on every WorkspacesChanged event.

  bar-widths --once   write the overrides and exit (before Noctalia starts)
  bar-widths          write them, then follow monitor changes
"""
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tomllib

BAR_WIDTH = 1240     # logical px: the bar on a 1440-wide laptop screen
WIDE_ABOVE = 1600    # screens up to this width keep the default margins

CONFIG = os.path.join(
    os.environ.get("NOCTALIA_CONFIG_HOME") or os.environ.get("XDG_CONFIG_HOME")
    or os.path.expanduser("~/.config"),
    "noctalia",
)
TARGET = os.path.join(CONFIG, "30-lucciola-monitors.toml")
SECONDARY_START = ["active_window"]   # bar start section without workspaces
HEADER = (
    "# Generated by /usr/libexec/lucciola/bar-widths: the bar stays "
    f"{BAR_WIDTH}px wide on screens wider than {WIDE_ABOVE}px, and screens\n"
    "# other than the one holding workspace \"1\" show no workspace indicator.\n"
    "# Rewritten whenever monitors change; do not edit (put your own bar "
    "settings in another file).\n"
)
LOCK_TARGET = os.path.join(CONFIG, "31-lucciola-lock.toml")
LOCK_HEADER = (
    "# Generated by /usr/libexec/lucciola/bar-widths: the lock screen arranged "
    "like the login screen, on every monitor.\n"
    "# Rewritten at each login and whenever monitors change; do not edit. To "
    "arrange it yourself use Noctalia's lockscreen\n"
    "# widget editor: what it saves wins over this file.\n"
)
ACCOUNT_PICTURES = os.environ.get("LUCCIOLA_ACCOUNT_PICTURES", "/var/lib/AccountsService/icons")
DEFAULT_PICTURE = "/usr/share/lucciola/avatar/lucciola.png"
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"))
SAVED_SETTINGS = os.path.join(os.environ.get("NOCTALIA_STATE_HOME") or os.path.join(STATE, "noctalia"), "settings.toml")
LOCK_RETIRED = os.path.join(STATE, "lucciola", "noctalia-saved-lock-widgets-retired")
# What pam_fprintd says on the login screen. Noctalia writes its own messages
# above the field only, so this one is a widget: errors and Caps Lock still
# appear above it, from Noctalia. A clock with no time in its format: a label
# wraps this length at its own fixed width, and a clock keeps one centred line
# sized by its box.
FINGERPRINT_LINE = "Place your finger on the fingerprint reader"
# The field stands where the login's does (525 of 960) and is centred by itself,
# with the eye outside it where the login has its arrow: the box is wider than
# the field by the eye, so it sits off centre by half of that. Picture and name
# keep the login's distance, with room for Noctalia's messages above the field.
FIELD_AT = 525 / 960
BOX_WIDTH = 471.0
EYE_OFFSET = 23
FINGERPRINT_COLOUR = "#8c8579"   # on_surface_variant of the login's palette
SESSION_ACTIONS = (  # bottom right, where the login screen has its own
    ("logout", "logout", "niri msg action quit --skip-confirmation"),
    ("suspend", "player-pause", "systemctl suspend"),
    ("reboot", "refresh", "systemctl reboot"),
    ("poweroff", "power", "systemctl poweroff"),
)


def niri_json(what):
    try:
        out = subprocess.run(["niri", "msg", "-j", what], capture_output=True,
                             text=True, timeout=5, check=True).stdout
        return json.loads(out)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def outputs():
    return niri_json("outputs")


def primary_output():
    for ws in niri_json("workspaces") or []:
        if ws.get("name") == "1":
            return ws.get("output")
    return None


def render(outs, primary):
    lines = [HEADER]
    for name in sorted(outs):
        logical = (outs[name] or {}).get("logical") or {}
        width = logical.get("width") or 0
        settings = []
        if width > WIDE_ABOVE:
            settings.append(f"margin_ends = {max(0, (width - BAR_WIDTH) // 2)}")
        if len(outs) > 1 and primary and name != primary:
            settings.append("start = " + json.dumps(SECONDARY_START))
        if not settings:
            continue
        key = "".join(c if c.isalnum() else "_" for c in name).lower()
        lines.append(f'\n[bar.default.monitor.lucciola_{key}]\nmatch = "{name}"\n'
                     + "".join(line + "\n" for line in settings))
    return "".join(lines)


def write(outs, primary):
    text = render(outs, primary)
    try:
        with open(TARGET) as f:
            if f.read() == text:
                return False
    except OSError:
        pass
    os.makedirs(CONFIG, exist_ok=True)
    tmp = TARGET + ".new"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, TARGET)
    return True


def toml_settings(settings):
    return "".join(f"{key} = {json.dumps(value)}\n" for key, value in settings.items())


def lock_widget(widget_id, kind, name, cx, cy, width, height, settings):
    return (f'\n[lockscreen_widgets.widget."{widget_id}"]\ntype = "{kind}"\noutput = {json.dumps(name)}\n'
            f"cx = {float(cx)}\ncy = {float(cy)}\nbox_width = {float(width)}\nbox_height = {float(height)}\n"
            f'rotation = 0.0\n\n[lockscreen_widgets.widget."{widget_id}".settings]\n' + toml_settings(settings))


def render_lock(outs, user, picture, weather, fingerprint):
    """The whole fragment, for the outputs that are on. Plain text, no widget
    without a monitor: Noctalia gives any other monitor its own default box."""
    order, tables = [], []
    quiet = {"shadow": False, "background": False}
    for name in sorted(outs):
        logical = (outs[name] or {}).get("logical") or {}
        width, height = logical.get("width") or 0, logical.get("height") or 0
        if not width or not height:
            continue
        key = "".join(c if c.isalnum() else "_" for c in name).lower()
        cx, field = width // 2, round(height * FIELD_AT)
        parts = [
            (f"lucciola-clock-{key}", "clock", cx, max(70, field - 375), 420, 120,
             {"format": "{:%H:%M}", "color": "primary", "center_text": True, **quiet}),
            (f"lucciola-picture-{key}", "sticker", cx, field - 144, 64, 64,
             {"image_path": picture, "opacity": 1.0, "background": False}),
            (f"lucciola-name-{key}", "label", cx, field - 88, 0, 0,
             {"title": user, "color": "primary", **quiet}),
            # The player scales its content with the box's height: 420x96 left
            # small type in a band of empty sides (2026-11-09); 320x150 fills it,
            # below the fingerprint line with a gap.
            (f"lucciola-media-{key}", "media_player", cx, field + 160, 320, 150,
             {"hide_when_no_media": True, "background": True, "background_color": "surface",
              "background_opacity": 0.75, "shadow": False}),
        ]
        if weather:
            parts.insert(1, (f"lucciola-weather-{key}", "weather", cx, max(70, field - 375) + 82, 340, 40,
                             {"color": "on_surface_variant", **quiet}))
        if fingerprint:
            parts.append((f"lucciola-fingerprint-{key}", "clock", cx, field + 46, 301, 18,
                          {"format": FINGERPRINT_LINE, "color": FINGERPRINT_COLOUR, "center_text": True, **quiet}))
        for index, (action, glyph, command) in enumerate(SESSION_ACTIONS):
            parts.append((f"lucciola-{action}-{key}", "button", width - 167 + 44 * index, height - 35, 0, 0,
                          {"glyph": glyph, "command": command, "variant": "ghost", "background": False,
                           "color": "on_surface_variant"}))
        box = f"lockscreen-login-box@{name}"
        order += [part[0] for part in parts] + [box]
        tables += [lock_widget(*part[:2], name, *part[2:]) for part in parts]
        tables.append(lock_widget(box, "login_box", name, cx + EYE_OFFSET, field, BOX_WIDTH, 60, {
            "layout": "compact", "show_session_buttons": False, "show_media": False, "show_weather": False,
            "show_password_reveal": True, "show_login_button": False, "show_keyboard_layout": True,
            "show_unlock_hint": False, "show_caps_lock": True, "center_password_text": False,
            "background_color": "surface", "background_opacity": 0.0, "background_radius": 12.0,
            "input_opacity": 0.0, "input_radius": 12.0,
        }).replace("rotation = 0.0\n", f"placement_width = {float(width)}\nplacement_height = {float(height)}\nrotation = 0.0\n", 1))
    if not tables:
        return LOCK_HEADER
    return (LOCK_HEADER + "\n[lockscreen_widgets]\nenabled = true\nschema_version = 2\n"
            f"widget_order = {json.dumps(order)}\n" + "".join(tables))


def account_picture(user):
    """The picture the login screen shows, as AccountsService keeps it where
    any account can read it; a square photo stays square here (the login
    screen rounds it, a sticker cannot)."""
    own = os.path.join(ACCOUNT_PICTURES, user)
    return own if os.access(own, os.R_OK) else DEFAULT_PICTURE


def location_known():
    """Weather without a location only says so: no widget until there is one."""
    paths = [SAVED_SETTINGS]
    try:
        paths += [os.path.join(CONFIG, f) for f in sorted(os.listdir(CONFIG)) if f.endswith(".toml")]
    except OSError:
        pass
    for path in paths:
        try:
            with open(path, "rb") as f:
                location = tomllib.load(f).get("location") or {}
        except (OSError, tomllib.TOMLDecodeError):
            continue
        if location.get("auto_locate") or location.get("address"):
            return True
    return False


def fingerprint_enrolled(user):
    try:
        out = subprocess.run(["fprintd-list", user], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return re.search(r"^\s*-\s*#\d+:", out, re.M) is not None


def retire_saved_lock_widgets():
    """Noctalia's saved settings win over the config files, and it saves its
    lock screen widgets, switched off, as soon as its editor is opened once: the
    arrangement above would never show. Once per account, with Noctalia not
    running; widgets switched on are someone's own and stay."""
    if os.path.exists(LOCK_RETIRED):
        return
    try:
        with open(SAVED_SETTINGS, encoding="utf-8") as f:
            text = f.read()
        saved = tomllib.loads(text).get("lockscreen_widgets")
    except (OSError, tomllib.TOMLDecodeError):
        saved, text = None, ""
    if saved is not None and not saved.get("enabled"):
        kept, dropping = [], False
        for line in text.splitlines(keepends=True):
            header = re.match(r"\s*\[+\s*([^\]]+)", line)
            if header and not line.lstrip().startswith(('"', "'")):
                dropping = header.group(1).strip().split(".")[0].strip('"') == "lockscreen_widgets"
            if not dropping:
                kept.append(line)
        shutil.copy2(SAVED_SETTINGS, SAVED_SETTINGS + ".bak-lock-widgets")
        tmp = SAVED_SETTINGS + ".new"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write("".join(kept))
        tomllib.loads("".join(kept))
        os.replace(tmp, SAVED_SETTINGS)
    os.makedirs(os.path.dirname(LOCK_RETIRED), exist_ok=True)
    open(LOCK_RETIRED, "w").close()


def write_lock(outs):
    user = pwd.getpwuid(os.getuid()).pw_name
    text = render_lock(outs, user, account_picture(user), location_known(), fingerprint_enrolled(user))
    try:
        with open(LOCK_TARGET) as f:
            if f.read() == text:
                return False
    except OSError:
        pass
    os.makedirs(CONFIG, exist_ok=True)
    tmp = LOCK_TARGET + ".new"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, LOCK_TARGET)
    return True


def signature(outs, primary):
    return (primary, sorted((n, ((o or {}).get("logical") or {}).get("width"),
                             ((o or {}).get("logical") or {}).get("height")) for n, o in outs.items()))


def reload_noctalia():
    subprocess.run(["noctalia", "msg", "config-reload"], capture_output=True, timeout=5)


def lock_step(step, *args):
    """The bar comes first: a failure here is said and leaves it alone, and the
    lock screen keeps what it has."""
    try:
        return step(*args)
    except (OSError, ValueError, KeyError) as e:
        print(f"bar-widths: lock screen arrangement not updated: {e}", file=sys.stderr)
        return False


def main():
    once = "--once" in sys.argv[1:]
    if once:
        lock_step(retire_saved_lock_widgets)
    outs = outputs()
    primary = primary_output()
    if outs is not None:
        write(outs, primary)
        lock_step(write_lock, outs)
    if once:
        return
    last = signature(outs, primary) if outs else None
    stream = subprocess.Popen(["niri", "msg", "-j", "event-stream"],
                              stdout=subprocess.PIPE, text=True)
    for line in stream.stdout:
        if '"WorkspacesChanged"' not in line:
            continue
        outs = outputs()
        if outs is None:
            continue
        primary = primary_output()
        current = signature(outs, primary)
        if current == last:
            continue
        last = current
        changed = write(outs, primary)
        if lock_step(write_lock, outs) or changed:
            reload_noctalia()


if __name__ == "__main__":
    main()
