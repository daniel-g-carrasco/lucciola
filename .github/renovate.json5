{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  // 'behind-base-branch', not 'never' (2026-08-20): with 'never' a
  // Renovate PR stayed pinned to whatever main looked like when it was
  // opened. Its checks were therefore stale, automerge would not touch
  // it, and a human had to press "Update branch" to make anything run
  // again — twice by hand on the o-tiling PR during the August build
  // outage. Rebasing when main moves is what makes the automation
  // self-sufficient: fresh checks, then Renovate merges on its own.
  rebaseWhen: 'behind-base-branch',
  // Archived Margine files (docs/history/, e.g. the live ISO's Containerfile)
  // are not maintained: no update PRs for them (2026-10-20). Setting
  // ignorePaths replaces the preset's list, so its entries are repeated.
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/examples/**',
    '**/__tests__/**',
    '**/test/**',
    '**/tests/**',
    '**/__fixtures__/**',
    'docs/history/**',
  ],
  packageRules: [
    {
      matchDepNames: [
        'ublue-os/titanoboa',
        'daniel-g-carrasco/titanoboa',
      ],
      enabled: false,
    },
    {
      // Auto-merge everything non-major once checks are green (2026-08-09).
      // Mechanics: platformAutomerge (Renovate default)
      // arms GitHub's native auto-merge on the PR; branch protection
      // requires the `lint` check, so a red PR can never slip through,
      // and the pin-sync workflow (scrcpy fix-sha) pushing to the branch
      // simply re-arms the wait on the new SHA. Major updates stay
      // manual by design: they are the ones that break rebases and APIs.
      automerge: true,
      // Renovate-side automerge (NOT GitHub's platform auto-merge):
      // platform auto-merge waits only for REQUIRED checks (lint), while
      // Renovate itself merges only when EVERY check on the PR is green,
      // including the non-required full image build that the vm-test
      // label triggers on baked-dependency bumps. That full build (with
      // the in-container validators) is the actual compatibility gate.
      platformAutomerge: false,
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'pinDigest',
        'digest',
      ],
    },
    {
      // Wait a day before proposing this one. It is pinned by the sha256
      // of a GitHub RELEASE ASSET, and a release is
      // not atomic: the tag exists, Renovate sees it, the PR opens, and
      // the zip is still uploading. On 2026-08-24 the o-tiling PR lost
      // that race by nineteen minutes:
      //
      //   15:04:13  fix-sha:  curl 404 on the release asset
      //   15:20:31  build:    same 404, after three retries
      //   15:23:29  upstream: asset finally published
      //
      // Two red checks and a manual re-run, for a bump that was fine.
      // The comment at the top of this file records the same dance
      // happening by hand twice in August. A day is generous against a
      // window measured in minutes, and scrcpy is not security-critical
      // enough to want it sooner. (o-tiling and wayland-scroll-factor were
      // tracked the same way in Margine; Lucciola ships neither.)
      matchDepNames: [
        'Genymobile/scrcpy',
      ],
      minimumReleaseAge: '1 day',
    },
    {
      // Anything baked into the image must prove it BUILDS before it
      // merges: the vm-test label makes build.yml run the full 30-min
      // image build (validators included) on the PR.
      matchFileNames: [
        'build_files/**',
        'Containerfile',
      ],
      addLabels: [
        'vm-test',
      ],
    },
    {
      // chunkah decides how the image is split into layers, and a new
      // release can change that plan (v0.7.0 reweighted package stability):
      // the first update after a bump then re-downloads more than usual for
      // every installed system. Proposed like everything else, merged only
      // by hand, after measuring the delta on the PR's :pr-N image.
      matchDepNames: [
        'quay.io/coreos/chunkah',
      ],
      automerge: false,
      addLabels: [
        'vm-test',
      ],
    },
    {
      // PRs that wait for a human (major updates, chunkah) rebase only on a
      // conflict, not every time main moves. With 'behind-base-branch' each
      // merge to main rebased them, and the vm-test label made each rebase a
      // full 30-45 minute image build: on 2026-10-16 three merges meant six
      // builds for #501 (Fedora 45 base) and #503 (chunkah), red or cancelled,
      // each one a notification. Automerged PRs keep rebasing on their own;
      // a manual PR is brought up to date with the "rebase" checkbox in its
      // description when someone is ready to look at it.
      matchUpdateTypes: [
        'major',
      ],
      rebaseWhen: 'conflicted',
    },
    {
      matchDepNames: [
        'quay.io/coreos/chunkah',
      ],
      rebaseWhen: 'conflicted',
    },
    {
      enabled: false,
      matchUpdateTypes: [
        'digest',
        'pinDigest',
        'pin',
      ],
      matchDepTypes: [
        'container',
      ],
      matchFileNames: [
        '.github/workflows/**.yaml',
        '.github/workflows/**.yml',
      ],
    },
    {
      // Containerfile base images (bluefin-dx, bluefin, bazzite, our own
      // margine) track the rolling :stable tag BY DESIGN — Margine rebuilds on
      // the upstream :stable cadence and stamps base.digest itself. Never let
      // Renovate pin them to a digest: it freezes nothing useful and produced a
      // recurring "pin dependencies" branch-update failure on the dashboard.
      // Tag/version bumps stay enabled; only pin/pinDigest/digest are off.
      enabled: false,
      matchManagers: [
        'dockerfile',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
        'pin',
      ],
    },
  ],
  customManagers: [
    {
      // chunkah is pinned as an env value (CHUNKAH_REF) in build.yml,
      // which no built-in manager reads: without this, a new release never
      // surfaced (upstream review 2026-10, issue #437).
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/build\\.yml$/',
      ],
      matchStrings: [
        'CHUNKAH_REF: (?<depName>quay\\.io/coreos/chunkah):(?<currentValue>v\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
    {
      // scrcpy (Phone Camera engine), pinned release tarball in
      // 70-phone-cam. Same sha-companion pattern: renovate bumps
      // SCRCPY_VERSION, .github/workflows/scrcpy-pin-sha.yml sets
      // SCRCPY_SHA256 on the branch. Since 2026-10-20 (review N2) that hash
      // is upstream's: read from the release's SHA256SUMS.txt once its
      // OpenPGP signature checks out against the maintainer's key pinned in
      // .github/keys, and build.yml's pins job checks it again on the PR
      // with main's copy of the verifier. A release without signed sums,
      // or signed by another key, turns the PR red, so automerge (which
      // waits for every check) stays off it until someone has looked. And
      // the build that runs the new binary no longer has the MOK key in
      // reach (review N1): only the mok-sign stage mounts it.
      customType: 'regex',
      managerFilePatterns: ['/build_files/70-phone-cam/install\\.sh$/'],
      matchStrings: ['SCRCPY_VERSION=(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)'],
      depNameTemplate: 'Genymobile/scrcpy',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
  ],
}
