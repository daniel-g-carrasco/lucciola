// Inline commands: monospace in the firefly's colour, never broken across lines.
const cmd = (text) =>
  `<span font_family="JetBrains Mono" size="93%" foreground="#e6d5bf">${text.replaceAll(" ", "\u00a0")}</span>`;
const esc = (text) => GLib.markup_escape_text(text, -1);

// Marks inside a text from content.json, as welcome_content.py's INLINE:
// `command`, **bold**, [words](where). Everything else is plain text.
const INLINE = /`([^`\n]+)`|\*\*([^*\n]+)\*\*|\[([^\[\]\n]*)\]\(([^()\s]*)\)/g;
function markup(text) {
  let out = "";
  let pos = 0;
  for (const m of text.matchAll(INLINE)) {
    out += esc(text.slice(pos, m.index));
    if (m[1] !== undefined) out += cmd(esc(m[1]));
    else if (m[2] !== undefined) out += `<b>${esc(m[2])}</b>`;
    else if (linkTarget(m[4])) out += `<a href="${esc(m[4])}">${esc(m[3])}</a>`;
    else out += esc(m[3]); // a link the window cannot open: its words only
    pos = m.index + m[0].length;
  }
  return out + esc(text.slice(pos));
}

// A blank line starts a paragraph; newlines at either end do not count.
const paragraphs = (text) => text.trim().split(/\n[ \t]*\n\s*/).map((p) => p.trim()).filter((p) => p);

// Where a link may go: the guide (from the top or at one of its sections),
// an installed app, or a web page in the default browser.
function linkTarget(href) {
  if (href === "guide") return { guide: null };
  let m = /^guide#([a-z][a-z0-9-]*)$/.exec(href);
  if (m) return { guide: m[1] };
  m = /^app:([A-Za-z0-9_][A-Za-z0-9_.-]*\.desktop)$/.exec(href);
  if (m) return { app: m[1] };
  if (/^https:\/\/[^\s"'<>\\]+$/.test(href)) return { web: href };
  return null;
}

// What a button in content.json may do, by name. b is the button's entry,
// win the window (for a short notice when something cannot open).
const ACTIONS = {
  "open-system": () => launch("dev.margine.System.desktop", "/usr/libexec/margine/system-gui"),
  "open-guide": () => launch("lucciola-guide.desktop", GUIDE_OPEN),
  "open-app": (b, win) => openApp(b.app, win),
};

// Without its texts the window still says hello and opens the guide.
const FALLBACK = {
  window_title: "Welcome to Lucciola",
  intro: "Welcome. The guide explains how Lucciola works.",
  sections: [{
    id: "guide", title: "the guide",
    blocks: [{ type: "button", action: "open-guide", label: "Open the guide", style: "cta" }],
  }],
  footer: { text: "To see this window again, press Super Space and look for Lucciola Welcome.", close_label: "Close" },
};

function loadContent() {
  try {
    const [, bytes] = GLib.file_get_contents(CONTENT);
    const content = JSON.parse(new TextDecoder().decode(bytes));
    if (!Array.isArray(content.sections) || !content.footer) throw new Error("no sections or footer");
    return content;
  } catch (e) {
    logError(e, `welcome: could not read ${CONTENT}`);
    return FALLBACK;
  }
}

function label(text, classes, extra = {}) {
  const l = new Gtk.Label({
    label: text,
    use_markup: true,
    wrap: true,
    wrap_mode: 2, // Pango.WrapMode.WORD_CHAR
    xalign: 0,
    halign: Gtk.Align.FILL,
    ...extra,
  });
  for (const c of classes) l.add_css_class(c);
  return l;
}

const launchContext = () => Gtk.Window.list_toplevels()[0]?.get_display().get_app_launch_context() ?? null;

function launch(desktopId, fallback) {
  const ctx = launchContext();
  const info = DesktopAppInfo.new(desktopId);
  try {
    if (info && info.launch([], ctx)) return;
  } catch (e) {
    logError(e, `welcome: could not launch ${desktopId}`);
  }
  try {
    Gio.Subprocess.new([fallback], Gio.SubprocessFlags.NONE);
  } catch (e) {
    logError(e, `welcome: could not start ${fallback}`);
  }
}

// An app by its desktop file. On the first start the Flatpaks are still
// downloading (Bazaar among them): say so rather than do nothing.
function openApp(desktopId, win) {
  const info = DesktopAppInfo.new(desktopId);
  if (info) {
    try {
      if (info.launch([], launchContext())) return;
    } catch (e) {
      logError(e, `welcome: could not launch ${desktopId}`);
      win.notice("That app did not start. Try again from the dock or with Super Space.");
      return;
    }
  }
  log(`welcome: ${desktopId} is not installed`);
  win.notice("That app is not installed yet. On the first start, apps download in the background: try again in a few minutes.");
}

function openLink(href, win) {
  const to = linkTarget(href);
  if (!to) {
    log(`welcome: link "${href}" left alone`);
  } else if (to.app) {
    openApp(to.app, win);
  } else if (to.web) {
    try {
      Gio.AppInfo.launch_default_for_uri(to.web, launchContext());
    } catch (e) {
      logError(e, `welcome: could not open ${to.web}`);
      win.notice("No browser could open that page.");
    }
  } else if (to.guide) {
    try {
      Gio.Subprocess.new([GUIDE_OPEN, to.guide], Gio.SubprocessFlags.NONE);
    } catch (e) {
      logError(e, `welcome: could not start ${GUIDE_OPEN}`);
    }
  } else {
    ACTIONS["open-guide"]();
  }
}

function markSeen() {
  try {
    GLib.mkdir_with_parents(STATE_DIR, 0o755);
    GLib.file_set_contents(MARKER, `${GLib.DateTime.new_now_local().format_iso8601()}\n`);
  } catch (e) {
    logError(e, `welcome: could not write ${MARKER}`);
  }
}

const WelcomeWindow = GObject.registerClass(
  class WelcomeWindow extends Adw.ApplicationWindow {
    _init(app) {
      const content = loadContent();
      super._init({
        application: app,
        title: content.window_title,
        default_width: 640,
        default_height: 820,
        width_request: 360,
        height_request: 420,
      });
      this.add_css_class("welcome");

      const toolbar = new Adw.ToolbarView();
      toolbar.add_top_bar(new Adw.HeaderBar({ show_title: false }));
      this.set_content(toolbar);

      this._toasts = new Adw.ToastOverlay();
      toolbar.set_content(this._toasts);
      const scroller = new Gtk.ScrolledWindow({
        hscrollbar_policy: Gtk.PolicyType.NEVER,
        vexpand: true,
      });
      this._toasts.set_child(scroller);

      const clamp = new Adw.Clamp({ maximum_size: 580, tightening_threshold: 460 });
      scroller.set_child(clamp);

      this._page = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 40,
        margin_start: 28,
        margin_end: 28,
        margin_top: 4,
        margin_bottom: 36,
      });
      clamp.set_child(this._page);

      this._page.append(this._hero(content.intro));
      for (const sec of content.sections) {
        if (sec.hidden) continue;
        const box = this._section(markup(sec.title), sec.blocks.map((b) => this._block(b)).filter((w) => w));
        // A conditional section keeps its place and shows up once it applies.
        if (sec.show_if) {
          box.visible = false;
          if (sec.show_if === "mok-pending") this._whenMokPending(() => { box.visible = true; });
        }
        this._page.append(box);
      }
      this._page.append(this._footer(content.footer));

      this.connect("close-request", () => {
        markSeen();
        return false;
      });
    }

    // A short line at the bottom of the window, for what did not open.
    notice(text) {
      this._toasts.add_toast(new Adw.Toast({ title: esc(text), timeout: 6 }));
    }

    // A text from content.json: one label per paragraph, its links opened
    // here (openLink), never by GTK's default handler.
    _rich(text, classes, extra = {}, spacing = 12) {
      const labels = paragraphs(text).map((p) => {
        // GTK puts a label with links in the Tab order on its own: Tab
        // reaches each link, Enter opens it.
        const l = label(markup(p), classes);
        l.connect("activate-link", (_l, href) => {
          openLink(href, this);
          return true;
        });
        return l;
      });
      if (labels.length === 1) {
        for (const [k, v] of Object.entries(extra)) labels[0][k] = v;
        return labels[0];
      }
      const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing, ...extra });
      for (const l of labels) box.append(l);
      return box;
    }

    _section(title, children) {
      const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 14 });
      const h = label(title, ["section-title"], { accessible_role: Gtk.AccessibleRole.HEADING });
      box.append(h);
      for (const c of children) box.append(c);
      return box;
    }

    _hero(intro) {
      const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 18 });
      const word = new Gtk.Box({ spacing: 7, halign: Gtk.Align.START });
      word.append(label("lucciola", ["wordmark"], { wrap: false }));
      const dot = new Gtk.Box({ valign: Gtk.Align.END, margin_bottom: 22 });
      dot.add_css_class("firefly");
      word.append(dot);
      box.append(word);
      box.append(this._rich(intro, ["lede"], {}, 14));
      return box;
    }

    _keycaps(combos) {
      const box = new Gtk.Box({ spacing: 5, valign: Gtk.Align.START, halign: Gtk.Align.START });
      combos.forEach((combo, i) => {
        if (i > 0) {
          const sep = new Gtk.Label({ label: "/", margin_start: 2, margin_end: 2 });
          sep.add_css_class("keysep");
          box.append(sep);
        }
        for (const k of combo) {
          const cap = new Gtk.Label({ label: k });
          cap.add_css_class("key");
          box.append(cap);
        }
      });
      return box;
    }

    _keyRows(rows) {
      const grid = new Gtk.Grid({ column_spacing: 22, row_spacing: 11 });
      rows.forEach(({ keys, label: what }, row) => {
        grid.attach(this._keycaps(keys), 0, row, 1, 1);
        grid.attach(this._rich(what, ["body", "tight"], { hexpand: true, valign: Gtk.Align.CENTER }, 6), 1, row, 1, 1);
      });
      return grid;
    }

    _bullets(items) {
      const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 10 });
      for (const text of items) {
        const row = new Gtk.Box({ spacing: 12 });
        const dot = new Gtk.Box({ valign: Gtk.Align.START, margin_top: 8 });
        dot.add_css_class("bullet");
        row.append(dot);
        row.append(this._rich(text, ["body"], { hexpand: true }, 8));
        box.append(row);
      }
      return box;
    }

    _button(text, style, onClick) {
      const b = new Gtk.Button({ label: text, halign: Gtk.Align.START });
      b.add_css_class(style);
      b.connect("clicked", onClick);
      return b;
    }

    // One entry of a section's "blocks" in content.json.
    _block(b) {
      switch (b.type) {
      case "text":
        return this._rich(b.text, b.dim ? ["body", "dim"] : ["body"]);
      case "items":
        return this._bullets(b.items);
      case "keys":
        return this._keyRows(b.rows);
      case "button": {
        const run = ACTIONS[b.action];
        if (!run) {
          log(`welcome: no action "${b.action}", button "${b.label}" left out`);
          return null;
        }
        return this._button(b.label, b.style === "cta" ? "cta" : "plain", () => run(b, this));
      }
      default:
        log(`welcome: unknown block type "${b.type}" left out`);
        return null;
      }
    }

    _footer(footer) {
      const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 18 });
      const rule = new Gtk.Box();
      rule.add_css_class("rule");
      box.append(rule);
      const row = new Gtk.Box({ spacing: 18 });
      row.append(this._rich(footer.text, ["body", "dim"], { hexpand: true, valign: Gtk.Align.CENTER }));
      const close = this._button(footer.close_label, "plain", () => this.close());
      close.set_valign(Gtk.Align.CENTER);
      row.append(close);
      box.append(row);
      return box;
    }

    // Only while the key waits for the blue screen at the next restart
    // (mok-notify sends the same words as a notification). Asked in the
    // background: mokutil must not delay the window.
    _whenMokPending(show) {
      if (!GLib.file_test(MOK_ENROLL, GLib.FileTest.IS_EXECUTABLE)) return;
      let proc;
      try {
        proc = Gio.Subprocess.new([MOK_ENROLL, "status"],
          Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE);
      } catch (e) {
        return;
      }
      proc.communicate_utf8_async(null, null, (p, res) => {
        let out = "";
        try {
          [, out] = p.communicate_utf8_finish(res);
        } catch (e) {
          return;
        }
        if ((out ?? "").trim() === "pending") show();
      });
    }
  },
);

const app = new Adw.Application({ application_id: APP_ID, flags: Gio.ApplicationFlags.FLAGS_NONE });
app.connect("startup", () => {
  // Lucciola is dark, and so is the website this page follows.
  Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK);
  const css = new Gtk.CssProvider();
  css.load_from_string(CSS);
  // Esc closes, as the page says nothing else needs doing here.
  app.set_accels_for_action("window.close", ["Escape", "<Control>w", "<Control>q"]);
  Gtk.StyleContext.add_provider_for_display(
    Gdk.Display.get_default(),
    css,
    Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
  );
});
app.connect("activate", () => {
  const win = app.get_active_window() ?? new WelcomeWindow(app);
  win.present();
});
app.run([system.programInvocationName]);
