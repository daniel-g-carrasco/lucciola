#!/usr/bin/gjs -m
// Welcome to Lucciola: the first steps, in one short page, at the first login
// of the Lucciola (niri) session.
//
// /usr/libexec/lucciola/session-start starts it with --first-login for new
// users (~/.local/state/lucciola/welcome-due, see there); "Lucciola Welcome"
// in the launcher (dev.margine.Welcome.desktop) opens it any time. Closing
// the window writes ~/.local/state/lucciola/welcome-seen, so it does not come
// back on its own; a session that ends with the window still open shows it
// again at the next login.
//
// The texts and their order live in /usr/share/lucciola/welcome/content.json
// (source: lucciola/system_files/usr/share/lucciola/welcome/content.json),
// edited with the content editor (`just edit`, tools/content-editor) and
// checked by tools/content-editor/welcome_content.py. This file only draws
// them: sections in file order, paragraphs, lists, key rows and the buttons,
// which the data names by action (ACTIONS below), never by command. Inside
// a text, `backticks` mark a command, **stars** bold words and
// [words](where) a link (openLink below); a newline breaks the line and a
// blank line starts a paragraph.
//
// Every fact on the page comes from the image itself, so keep them in step:
//   keys     /usr/share/lucciola/niri/config.kdl (binds)
//   updates  uupd.timer (system image, daily, staged for the next boot),
//            margine-flatpak-update.timer and margine-flatpak-user-update.timer
//            (apps, skipped on a low battery or a metered connection),
//            staged-update-notify ("Update ready"), system-gui (Lucciola
//            System: pkexec only for system-update and rpm-ostree rollback,
//            restarts only when asked), margine-brew-upgrade.timer (weekly,
//            only where the user installed Homebrew)
//   apps     flatpak-preinstall.service, margine-defaults.preinstall
//   guide    guide-open, lucciola-guide.desktop (pinned in the dock)
//   open-app any installed app by desktop file (Bazaar, a Flatpak, arrives
//            with flatpak-preinstall.service on the first start)
//   secure   mok-enroll status (section shown only while enrollment is pending)
// The look follows the website (site/index.html): the dark ground, the beige
// firefly, JetBrains Mono for the name, the headings and the keys.

import GObject from "gi://GObject";
import Gio from "gi://Gio";
import GLib from "gi://GLib";
import Gdk from "gi://Gdk?version=4.0";
import Gtk from "gi://Gtk?version=4.0";
import Adw from "gi://Adw?version=1";
import system from "system";

// GLib 2.86 moved DesktopAppInfo to GioUnix (Gio's copy warns on Fedora 45);
// fall back to Gio's where GioUnix is missing.
// Touching Gio.DesktopAppInfo at all prints the warning, so only on failure.
let DesktopAppInfo;
try {
  DesktopAppInfo = (await import("gi://GioUnix?version=2.0")).default.DesktopAppInfo;
} catch (_e) {
  DesktopAppInfo = Gio.DesktopAppInfo;
}

// The app id keeps the Margine family of dev.margine.System: it is the
// window's Wayland app_id and must equal the .desktop file's name.
const APP_ID = "dev.margine.Welcome";
const STATE_DIR = GLib.build_filenamev([GLib.get_user_state_dir(), "lucciola"]);
const MARKER = GLib.build_filenamev([STATE_DIR, "welcome-seen"]);
const MOK_ENROLL = "/usr/libexec/margine/mok-enroll";
const GUIDE_OPEN = "/usr/libexec/margine/guide-open";
const CONTENT = GLib.getenv("LUCCIOLA_WELCOME_CONTENT") ?? "/usr/share/lucciola/welcome/content.json";

const FIRST_LOGIN = ARGV.includes("--first-login");
// Started by session-start, but someone already closed it (a second session
// of the same user, a session-start run by hand): nothing to show.
if (FIRST_LOGIN && GLib.file_test(MARKER, GLib.FileTest.EXISTS)) system.exit(0);

// The website's palette (site/index.html :root).
const CSS = `
window.welcome {
  background-color: #121212;
  color: #ece6df;
}
window.welcome headerbar {
  background: none;
  box-shadow: none;
  color: #b8b2ab;
}
.welcome .wordmark {
  font-family: "JetBrains Mono", monospace;
  font-weight: 300;
  font-size: 44px;
  letter-spacing: -1.6px;
  color: #ece6df;
}
.welcome .firefly {
  min-width: 7px;
  min-height: 7px;
  border-radius: 999px;
  background-color: #e6d5bf;
  box-shadow: 0 1px 6px 1px alpha(#e6d5bf, 0.65), 0 2px 18px 6px alpha(#e6d5bf, 0.18);
  animation: glow 6s ease-in-out infinite;
}
@keyframes glow { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
.welcome .lede {
  font-size: 17px;
  color: #ece6df;
}
.welcome .section-title {
  font-family: "JetBrains Mono", monospace;
  font-weight: 500;
  font-size: 15px;
  color: #e6d5bf;
}
.welcome .body {
  font-size: 15px;
  line-height: 1.15;
  color: #ece6df;
}
.welcome .tight {
  line-height: 1;
}
.welcome label link {
  color: #ece6df;
  text-decoration-line: underline;
  text-decoration-color: alpha(#cba6f7, 0.7);
}
.welcome label link:hover {
  color: #cba6f7;
}
/* GTK draws this outline only around the link that Tab reached. */
.welcome label link {
  outline: 2px solid #e6d5bf;
  outline-offset: 2px;
  border-radius: 4px;
}
.welcome .dim {
  color: #b8b2ab;
}
.welcome .bullet {
  min-width: 5px;
  min-height: 5px;
  border-radius: 999px;
  background-color: #e6d5bf;
}
.welcome .key {
  font-family: "JetBrains Mono", monospace;
  font-size: 12px;
  color: #ece6df;
  background-color: #1a1a1a;
  border: 1px solid #2a2a2e;
  border-bottom-width: 2px;
  border-radius: 6px;
  padding: 1px 7px;
  min-width: 10px;
}
.welcome .keysep {
  font-family: "JetBrains Mono", monospace;
  font-size: 12px;
  color: #b8b2ab;
}
.welcome .rule {
  background-color: #2a2a2e;
  min-height: 1px;
}
.welcome button.cta,
.welcome button.plain {
  font-family: "JetBrains Mono", monospace;
  font-weight: 500;
  font-size: 13px;
  border-radius: 10px;
  padding: 9px 16px;
  box-shadow: none;
}
.welcome button.cta {
  background-color: #e6d5bf;
  color: #121212;
}
.welcome button.cta:hover { background-color: #f0e5d8; }
.welcome button.cta:active { background-color: #d9c6ae; }
.welcome button.plain {
  background-color: transparent;
  color: #b8b2ab;
  border: 1px solid #2a2a2e;
}
.welcome button.plain:hover {
  background-color: #e6d5bf;
  border-color: #e6d5bf;
  color: #121212;
}
