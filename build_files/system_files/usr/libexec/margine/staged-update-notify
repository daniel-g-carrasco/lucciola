#!/usr/bin/env bash
# Lucciola: session-side visibility for the update flow.
#
# Silent situations become desktop toasts (the restart into a new image is
# margine-upgrade-notify's, at login):
#   1. a NEW deployment just got staged: one notice per staged checksum,
#      at the next timer tick ("reboot whenever it suits you");
#   2. a staged deployment has been WAITING for days: daily low-urgency
#      nag (real incident 2026-06-11: a gnome-shell crash fix sat staged
#      for two days while the user kept hitting the crash);
#   3. margine-update-watchdog EXCLUDED an app from unattended updates
#      (extra-data app whose vendor download kept wedging uupd,
#      2026-06-28 and 2026-07-08): one notice per app, with the
#      recovery command.
#
# Runs from a user timer (margine-staged-update-notify.timer):
# rpm-ostree status is daemon-mediated and read-only for users.
set -euo pipefail

# margine-notify (NOT notify-send): fills the fdo app_icon field so the
# Margine logo also shows on the LOCK SCREEN rows (see the helper's
# header + docs/BRANDING.md). notify-send leaves app_icon empty.
MN=/usr/libexec/margine/margine-notify
command -v rpm-ostree >/dev/null 2>&1 || exit 0
[[ -x "$MN" ]] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

# Nobody would see a toast now: no graphical session (a user manager that SSH
# started), or a locked screen (an update staged at 04:11 would burn its one
# notice on an empty room). The stamps stay unwritten, so the first tick after
# the unlock says it.
SESSION="$(loginctl show-user "$(id -un)" -p Display --value 2>/dev/null || true)"
[[ -n "$SESSION" ]] || exit 0
[[ "$(loginctl show-session "$SESSION" -p LockedHint --value 2>/dev/null || true)" != yes ]] || exit 0

MIN_AGE_DAYS=2
STAMP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/margine"
mkdir -p "$STAMP_DIR"

ROS="$(rpm-ostree status --json 2>/dev/null || echo '{}')"
STAGED_JSON="$(printf '%s' "$ROS" | jq -c '[.deployments[]? | select(.staged == true)][0] // empty')"
SEEN="$STAMP_DIR/staged-seen"

if [[ -n "$STAGED_JSON" ]]; then
  STAGED_SUM="$(printf '%s' "$STAGED_JSON" | jq -r '.checksum // empty')"
  STAGED_VER="$(printf '%s' "$STAGED_JSON" | jq -r '.version // "A newer Lucciola"')"
  STAGED_TS="$(printf '%s' "$STAGED_JSON" | jq -r '.timestamp // empty')"

  # (1) First sight of THIS staged update: tell the user right away.
  # Stamp written only AFTER a successful notification, so a tick that
  # fires with no notification daemon around (SSH-spawned user manager)
  # doesn't burn the notice.
  if [[ -n "$STAGED_SUM" && "$(cat "$SEEN" 2>/dev/null)" != "$STAGED_SUM" ]]; then
    "$MN" -u normal -d dev.margine.System \
      "Update ready" \
      "${STAGED_VER} is downloaded and staged. Restart whenever it suits you to apply it; Lucciola System has the button." \
      && printf '%s\n' "$STAGED_SUM" > "$SEEN"
  fi

  # (2) Staged and forgotten: daily nag once it has been waiting.
  # .timestamp is the image build time, a good-enough age proxy.
  if [[ -n "$STAGED_TS" ]]; then
    AGE_DAYS=$(( ($(date +%s) - STAGED_TS) / 86400 ))
    STAMP="$STAMP_DIR/staged-notify.stamp"
    TODAY="$(date +%F)"
    if (( AGE_DAYS >= MIN_AGE_DAYS )) && [[ "$(cat "$STAMP" 2>/dev/null)" != "$TODAY" ]]; then
      "$MN" -u normal -d dev.margine.System \
        "Update staged for ${AGE_DAYS} days" \
        "A newer Lucciola is already downloaded and waiting. Restart whenever it suits you to apply it; until then you keep running the previous version." \
        && printf '%s\n' "$TODAY" > "$STAMP"
    fi
  fi
else
  # Nothing waits any more: the same checksum staged again is news again.
  rm -f "$SEEN"
fi

# (3) Watchdog exclusions: one notice per excluded app.
BLOCKED=/var/lib/margine/update-watchdog/blocked
if [[ -s "$BLOCKED" ]]; then
  NOTIFIED="$STAMP_DIR/blocked-notified"
  touch "$NOTIFIED"
  while read -r app when _reason; do
    [[ -n "$app" ]] || continue
    grep -qx "$app" "$NOTIFIED" && continue
    "$MN" -u normal -d dev.margine.System \
      "$app excluded from automatic updates" \
      "Its vendor download kept hanging unattended updates (since $when). Update it when you want from Lucciola System, under Apps: that takes it back in." \
      && printf '%s\n' "$app" >> "$NOTIFIED"
  done < "$BLOCKED"
fi

# (4) A failed or hung automatic run (uupd, the Flatpak updaters, brew):
# one notice per run, keyed on the unit and the time it ended, with the
# reason update-state reads from the journal (2026-11-01: a distrobox that
# no longer started had failed uupd for days in silence). Lucciola System
# shows the whole log; the bar's Updates glyph points there too.
US=/usr/libexec/lucciola/update-state
if [[ -x "$US" ]]; then
  STATE_JSON="$("$US" --json 2>/dev/null || echo '{}')"
  while IFS=$'\t' read -r _key title unit last line; do
    [[ -n "$unit" && -n "$last" ]] || continue
    STAMP="$STAMP_DIR/update-failed-${unit}"
    [[ "$(cat "$STAMP" 2>/dev/null)" == "$last" ]] && continue
    "$MN" -u normal -d dev.margine.System \
      "Automatic update failed: ${title}" \
      "${line}. Lucciola System, Overview, has the details." \
      && printf '%s\n' "$last" > "$STAMP"
  done < <(printf '%s' "$STATE_JSON" | jq -r '.channels[]? | select(.outcome == "failed" or .outcome == "hung")
            | [.key, .title, (.unit // ""), ((.last // 0) | tostring), (.line // "")] | @tsv' 2>/dev/null)
fi
