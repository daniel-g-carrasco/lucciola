    def _build_login(self):
        page = preferences_page()
        who = Adw.PreferencesGroup(
            title="Who Logs In",
            description="The login screen takes a fingerprint or the password. The keyring, where apps keep their passwords, opens with the login password or, with the setting below, with the TPM.",
        )
        page.add(who)
        fp = Adw.ActionRow(title="Fingerprint", subtitle="Register or remove fingerprints in Settings, under Users")
        fp.add_prefix(icon("auth-fingerprint-symbolic"))
        fp.add_suffix(icon("go-next-symbolic"))
        fp.set_activatable(True)
        fp.connect("activated", self._on_fingerprint)
        who.add(fp)

        keyring = Adw.PreferencesGroup(title="Keyring")
        page.add(keyring)
        self._keyring_row = info_row(keyring, "Keyring", "dialog-password-symbolic")
        self._keyring_login_row = info_row(keyring, "At Login", "dialog-password-symbolic")
        self._keyring_tpm_button = button_row(keyring, "Open the Keyring at Login with the TPM…", "dialog-password-symbolic", self._on_keyring_tpm, "suggested-action")
        self._keyring_tpm_off_button = button_row(keyring, "Ask the Keyring Password at Login Again…", "dialog-password-symbolic", self._on_keyring_tpm_off, "destructive-action")

        auto = Adw.PreferencesGroup(title="Automatic Login")
        page.add(auto)
        self._autologin_switch = Adw.SwitchRow(title="Log In Automatically", subtitle="Checking…")
        self._autologin_switch.connect("notify::active", self._on_autologin_toggled)
        auto.add(self._autologin_switch)
        return page

    def _refresh_login(self):
        gen = self._bump("login")
        for row in (self._keyring_row, self._keyring_login_row):
            self._set_loading(row, True)
        self._keyring_tpm_button.set_sensitive(False)
        self._keyring_tpm_off_button.set_sensitive(False)

        def worker():
            _, out, err = run([AUTOLOGIN, "status"])
            enabled, user = ls.parse_autologin(out + err)
            on_main(self._set_autologin, gen, enabled, user)
            _, out, err = run([KEYRING, "status"], timeout=30)
            on_main(self._set_keyring, gen, ls.parse_keyring_status(out + err))

        in_thread(worker)

    def _set_autologin(self, gen, enabled, user):
        if not self._current("login", gen):
            return
        self._autologin_guard = True
        self._autologin_switch.set_active(bool(enabled))
        self._autologin_guard = False
        if enabled is None:
            self._autologin_switch.set_subtitle("Could not read the login screen's setting")
            self._autologin_switch.set_sensitive(False)
            return
        self._autologin_switch.set_sensitive(not self._busy)
        self._autologin_switch.set_subtitle(
            f"{user} is logged in at startup without a password or fingerprint" if enabled
            else "The login screen asks for a fingerprint or the password at startup"
        )

    def _set_keyring(self, gen, st):
        if not self._current("login", gen):
            return
        self._keyring_state = st
        self._set_loading(self._keyring_row, False)
        self._set_loading(self._keyring_login_row, False)
        self._keyring_row.set_subtitle(
            "Unlocked: apps reach their saved passwords" if st["unlocked"] else
            "Locked: apps ask for its password" if st["unlocked"] is False else
            "The keyring service did not answer"
        )
        at = st["at_login"]
        self._keyring_login_row.set_subtitle({
            "tpm-used": "Opened by the TPM at this login, no password asked",
            "tpm-present": "A TPM credential is stored; this login used the password instead",
            "tpm-wrong": "The stored TPM credential holds a wrong password: set it again",
            "tpm-next": "A TPM credential is stored and applies from the next login",
            "password": "Opened with the login password; a fingerprint login leaves it locked",
            None: "Unknown",
        }[at])
        has_cred = at in ("tpm-used", "tpm-present", "tpm-wrong", "tpm-next")
        self._keyring_tpm_button.set_title("Set the TPM Credential Again…" if at == "tpm-wrong" else "Open the Keyring at Login with the TPM…")
        self._keyring_tpm_button.set_visible(at in ("password", "tpm-wrong", None))
        self._keyring_tpm_button.set_sensitive(not self._busy)
        self._keyring_tpm_off_button.set_visible(has_cred)
        self._keyring_tpm_off_button.set_sensitive(not self._busy)

    def _on_fingerprint(self, _row):
        try:
            Gio.Subprocess.new(["gnome-control-center", "user-accounts"], Gio.SubprocessFlags.NONE)
