        gen = self._bump("apps")
        for row in list(self._profile_rows.values()) + [self._spola_row, self._netflix_row, self._darktable_row, self._blender_row, self._excluded_row]:
            self._set_loading(row, True)

        def worker():
            rc, out, _ = run([FEATURE, "all", "status"], timeout=90)
            statuses = ls.feature_statuses(out) if rc == 0 else {}
            profile = ls.apps_profile(statuses.get("slim", {}).get("state", "unknown"), statuses.get("naked", {}).get("state", "unknown"))
            excluded = ls.excluded_apps(read_file(BLOCKED))
            present = {}
            for app in (SPOLA_APP, ZEN_APP, DARKTABLE_APP, BLENDER_APP):
                rc_u, _, _ = run(["flatpak", "info", "--user", app])
                rc_s, _, _ = run(["flatpak", "info", "--system", app])
                present[app] = rc_u == 0 or rc_s == 0
            if present[ZEN_APP]:
                rc, out, _ = run([UJUST, "lucciola-netflix-1080p", "status"], timeout=60)
                netflix = ls.netflix_state(out, rc)
            else:
                netflix = "no-browser"
            _, lspci, _ = run(["lspci"])
            amd = ls.amd_gpu(lspci)
            _, dt_show, _ = run(["flatpak", "override", "--user", "--show", DARKTABLE_APP])
            _, bl_show, _ = run(["flatpak", "override", "--user", "--show", BLENDER_APP])
            tweaks = {
                "darktable": (present[DARKTABLE_APP] and amd, ls.override_set(dt_show, "OCL_ICD_VENDORS")),
                "blender": (present[BLENDER_APP] and amd, ls.override_set(bl_show, "blender-rocm")),
