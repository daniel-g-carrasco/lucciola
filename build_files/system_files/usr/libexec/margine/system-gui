    def _on_report(self):
        def worker():
            rc, out, err = run([REPORT], timeout=120)
            on_main(self._report_done, rc, out.strip(), err.strip())

        in_thread(worker)

    def _report_done(self, rc, path, err):
        if rc != 0 or not path:
            self._toast(f"Could not write the report: {err or 'unknown error'}")
            return
        dialog = Adw.AlertDialog(
            heading="Report Written",
            body=(f"A summary of this system is in {path}: image and versions, hardware, Secure Boot, apps and "
                  "this start's error lines. Attach it to the issue, or paste it in the Logs field."),
