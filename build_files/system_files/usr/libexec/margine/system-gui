    def _phone_subscribe(self):
        """The daemon's signals refresh the page while it is open: a phone
        appearing, a pairing request, a device changing state."""
        if self._phone_signal_ids:
            return
        bus = self._bus()
        for iface, member in ((KDEC_DAEMON, "deviceListChanged"), (KDEC_DAEMON, "pairingRequestsChanged"),
                              (KDEC_DEVICE, "pairStateChanged"), (KDEC_DEVICE, "reachableChanged"),
                              (KDEC_DEVICE, "pluginsChanged")):
            sid = bus.signal_subscribe(KDEC_BUS, iface, member, None, None, Gio.DBusSignalFlags.NONE,
                                       lambda *_: self._phone_refresh_soon())
            self._phone_signal_ids.append(sid)

    def _phone_refresh_soon(self):
        if self._phone_refresh_pending or self._current_page != "phone":
            return
        self._phone_refresh_pending = True

        def go():
            self._phone_refresh_pending = False
            self._refresh_phone()
            return False

        GLib.timeout_add(600, go)

    def _refresh_phone(self):
        gen = self._bump("phone")
        installed = os.path.exists(KDECONNECTD)
        self._phone_missing.set_visible(not installed)
        for group in (self._phone_pc, self._phone_devices_group, self._phone_more):
            group.set_visible(installed)
        self._phone_look_button.set_sensitive(False)

        def camera_worker():
            # The camera side: the loopback device, the phones adb sees,
            # the wireless debugging services on the network.
            self._cam_device = find_loopback_device()
            _, out, _ = run([ADB, "devices", "-l"], timeout=15)
            self._adb_devices = ls.adb_devices(out)
            _, out, _ = run([ADB, "mdns", "services"], timeout=10)
            self._adb_services = ls.mdns_services(out)

        if not installed:
            def worker_usb():
                camera_worker()
                on_main(self._set_phone, gen, "", [])

            in_thread(worker_usb)
            return

        def worker():
            camera_worker()
            name = self._kdec_call(KDEC_PATH, KDEC_DAEMON, "announcedName")
            name = name[0] if name else ""
            ids = self._kdec_call(KDEC_PATH, KDEC_DAEMON, "devices", GLib.Variant("(bb)", (False, False)))
            devices = []
            for dev_id in (ids[0] if ids else []):
                path = f"{KDEC_PATH}/devices/{dev_id}"
                props = self._kdec_props(path, KDEC_DEVICE)
                if not props:
                    continue
                state = ls.device_state(props.get("isPaired", False), props.get("isReachable", False),
                                        props.get("isPairRequestedByPeer", False), props.get("isPairRequested", False))
                battery = self._kdec_props(f"{path}/battery", "org.kde.kdeconnect.device.battery") if state == "connected" else {}
                config = read_file(os.path.join(KDEC_CONFIG, dev_id, "config"))
                functions = []
                if props.get("isPaired"):
                    supported = set(props.get("supportedPlugins") or [])
                    for plugin, title, blurb in ls.PHONE_FUNCTIONS:
                        if plugin not in supported:
                            continue
                        explicit = ls.plugin_setting(config, plugin)
                        if explicit is None and plugin in ls.PHONE_DEFAULT_OFF:
                            # Lucciola's default, written once so the daemon keeps it.
                            self._kdec_call(path, KDEC_DEVICE, "setPluginEnabled", GLib.Variant("(sb)", (plugin, False)))
                            explicit = False
                        if explicit is None:
                            reply = self._kdec_call(path, KDEC_DEVICE, "isPluginEnabled", GLib.Variant("(s)", (plugin,)))
                            explicit = bool(reply[0]) if reply else False
                        functions.append((plugin, title, blurb, explicit))
                devices.append({
                    "id": dev_id, "path": path, "name": props.get("name") or dev_id, "type": props.get("type") or "",
                    "state": state, "key": props.get("verificationKey") or "",
                    "addresses": list(props.get("reachableAddresses") or []),
                    "battery": battery.get("charge") if battery.get("hasBattery", True) else None,
                    "charging": bool(battery.get("isCharging", False)),
                    "functions": functions,
                })
            devices.sort(key=ls.device_sort_key)
            # A phone that advertises wireless debugging and is not connected
            # yet: try once here, so the Camera row says what is true (paired
            # phones connect, unpaired ones do not) instead of guessing.
            tried = False
            for d in devices:
                if d["state"] != "connected" or self._wireless_device_for(d) is not None:
                    continue
                service = ls.connect_service_for(self._adb_services, d["addresses"])
                if service is not None:
                    run([ADB, "connect", f"{service['host']}:{service['port']}"], timeout=12)
                    tried = True
            if tried:
                _, out, _ = run([ADB, "devices", "-l"], timeout=15)
                self._adb_devices = ls.adb_devices(out)
            on_main(self._set_phone, gen, name, devices)

        in_thread(worker)

    def _set_phone(self, gen, name, devices):
        if not self._current("phone", gen):
            return
        self._phone_subscribe()
        self._phone_devices = devices
        self._phone_name_guard = True
        self._phone_name_row.set_text(name)
        self._phone_name_guard = False
        self._phone_look_button.set_sensitive(not self._busy)
        for row in self._phone_rows:
            self._phone_devices_group.remove(row)
        self._phone_rows = []
        self._set_usb_camera_rows()
        if not devices:
            row = Adw.ActionRow(title="No phone yet", subtitle="Open KDE Connect on the phone, on the same Wi-Fi: this PC appears there, and the phone appears here")
            row.add_prefix(icon("phone-symbolic"))
            self._phone_devices_group.add(row)
            self._phone_rows.append(row)
            return
        for device in devices:
            row = self._phone_device_row(device)
            self._phone_devices_group.add(row)
            self._phone_rows.append(row)

    def _phone_device_row(self, device):
        state = device["state"]
        label = ls.DEVICE_STATE_LABELS[state]
        battery = ls.battery_phrase(device["battery"], device["charging"])
        subtitle = f"{label}. {battery}" if battery else label
        if state == "wants-to-pair" and device["key"]:
            subtitle += f". Key {device['key']}: the phone shows the same one"
        icon_name = "phone-symbolic" if "phone" in device["type"] else "computer-symbolic"
        if state in ("connected", "paired-away"):
            row = Adw.ExpanderRow(title=device["name"], subtitle=subtitle)
            row.add_prefix(icon(icon_name))
            if state == "connected":
                button_row(row, "Ring the Phone", "audio-volume-high-symbolic", lambda *_: self._phone_simple(device, "findmyphone", "org.kde.kdeconnect.device.findmyphone", "ring", "Ringing the phone"))
                button_row(row, "Send a File…", "document-send-symbolic", lambda *_: self._on_phone_send(device))
                if any(p == "kdeconnect_sftp" and on for p, _t, _b, on in device["functions"]):
                    # The plugin mounts the phone (sshfs) and opens the mount point in Files.
                    button_row(row, "Browse the Phone in Files", "folder-remote-symbolic", lambda *_: self._phone_simple(device, "sftp", "org.kde.kdeconnect.device.sftp", "startBrowsing", "Opening the phone in Files"))
            for plugin, title, blurb, enabled in device["functions"]:
                switch = Adw.SwitchRow(title=title, subtitle=blurb)
                switch.set_active(enabled)
                switch.connect("notify::active", self._on_phone_function, device, plugin)
                row.add_row(switch)
            if any(p == "kdeconnect_runcommand" for p, *_ in device["functions"]):
                button_row(row, "Add Ready-Made Commands", "utilities-terminal-symbolic", lambda *_: self._on_phone_commands(device))
            if state == "connected" and "phone" in device["type"]:
                self._add_camera_rows(row, device)
            button_row(row, "Forget This Phone…", "edit-delete-symbolic", lambda *_: self._on_phone_unpair(device), "destructive-action")
            return row
        row = Adw.ActionRow(title=device["name"], subtitle=subtitle)
        row.set_subtitle_lines(3)
        row.add_prefix(icon(icon_name))
        if state == "wants-to-pair":
            accept = Gtk.Button(label="Accept", valign=Gtk.Align.CENTER)
            accept.add_css_class("suggested-action")
            accept.connect("clicked", lambda *_: self._phone_simple(device, None, KDEC_DEVICE, "acceptPairing", "Pairing accepted"))
            reject = Gtk.Button(label="Reject", valign=Gtk.Align.CENTER)
            reject.connect("clicked", lambda *_: self._phone_simple(device, None, KDEC_DEVICE, "cancelPairing", "Pairing rejected"))
            row.add_suffix(accept)
            row.add_suffix(reject)
        elif state == "available":
            pair = Gtk.Button(label="Pair…", valign=Gtk.Align.CENTER)
            pair.connect("clicked", lambda *_: self._on_phone_pair(device))
            row.add_suffix(pair)
        elif state == "requested":
            cancel = Gtk.Button(label="Cancel", valign=Gtk.Align.CENTER)
            cancel.connect("clicked", lambda *_: self._phone_simple(device, None, KDEC_DEVICE, "cancelPairing", "Pairing request withdrawn"))
            row.add_suffix(cancel)
        return row

    def _phone_simple(self, device, plugin, iface, method, done):
        """A method with no arguments on the device or one of its plugins."""
        path = device["path"] + (f"/{plugin}" if plugin else "")

        def worker():
            ok = self._kdec_call(path, iface, method) is not None
            on_main(self._toast, done if ok else "KDE Connect did not answer")
            on_main(self._phone_refresh_soon)

        in_thread(worker)

    def _on_phone_pair(self, device):
        self._confirm(
            f"Pair With {device['name']}?",
            "The phone shows a request with a key; this page shows the same key. Accept on the phone when the two match.",
            "Pair", lambda: self._phone_simple(device, None, KDEC_DEVICE, "requestPairing", "Pairing requested: accept on the phone"),
        )

    def _on_phone_unpair(self, device):
        self._confirm(
            f"Forget {device['name']}?",
            "The two stop talking until they pair again. Nothing is deleted on either side.",
            "Forget", lambda: self._phone_simple(device, None, KDEC_DEVICE, "unpair", f"{device['name']} forgotten"), destructive=True,
        )

    def _on_phone_function(self, switch, _pspec, device, plugin):
        wanted = switch.get_active()

        def worker():
            self._kdec_call(device["path"], KDEC_DEVICE, "setPluginEnabled", GLib.Variant("(sb)", (plugin, wanted)))

        in_thread(worker)

    def _on_phone_send(self, device):
        dialog = Gtk.FileDialog()
        dialog.set_title("Send to the Phone")

        def done(d, result):
            try:
                file = d.open_finish(result)
            except GLib.Error:
                return
            uri = file.get_uri()

            def worker():
                ok = self._kdec_call(device["path"] + "/share", "org.kde.kdeconnect.device.share", "shareUrl", GLib.Variant("(s)", (uri,))) is not None
                on_main(self._toast, f"Sending {file.get_basename()} to {device['name']}" if ok else "KDE Connect did not take the file")

            in_thread(worker)

        dialog.open(self, None, done)

    def _on_phone_commands(self, device):
        names = ", ".join(name for name, _ in ls.PHONE_COMMANDS)
        self._confirm(
            "Add the Ready-Made Commands?",
            f"The phone gets these commands for this PC, under Run Command in the KDE Connect app: {names}. Commands already there stay; add your own from KDE Connect's own settings.",
            "Add", lambda: self._phone_add_commands(device),
        )

    def _phone_add_commands(self, device):
        import uuid
        folder = os.path.join(KDEC_CONFIG, device["id"], "kdeconnect_runcommand")
        path = os.path.join(folder, "config")
        text, added = ls.commands_config(read_file(path), ls.PHONE_COMMANDS, lambda: str(uuid.uuid4()))
        try:
            os.makedirs(folder, mode=0o700, exist_ok=True)
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(text)
        except OSError as e:
            self._toast(f"Could not write the commands: {e}")
            return

        def worker():
            self._kdec_call(device["path"], KDEC_DEVICE, "reloadPlugins")
            on_main(self._toast, f"{added} command{'s' if added != 1 else ''} added: they appear in the app on the phone" if added else "The commands were already there")

        in_thread(worker)

    def _on_phone_look(self, _row):
        self._phone_look_button.set_sensitive(False)

        def worker():
            self._kdec_call(KDEC_PATH, KDEC_DAEMON, "forceOnNetworkChange")
            time.sleep(2)
            on_main(self._refresh_phone)

        in_thread(worker)

    def _on_phone_name_apply(self, row):
        if self._phone_name_guard:
            return
        name = row.get_text().strip()
        if not name:
            return

        def worker():
            self._kdec_call(KDEC_PATH, KDEC_DAEMON, "setAnnouncedName", GLib.Variant("(s)", (name,)))
            on_main(self._toast, f"This PC is {name} to the phone now")

        in_thread(worker)

    # ── the phone as a webcam ────────────────────────────────────────

    def _usb_phones(self):
        return [d for d in self._adb_devices if not d["wireless"]]

    def _wireless_device_for(self, device):
        """An adb device already connected over the network at one of the
        phone's addresses, as adb lists it."""
        for d in self._adb_devices:
            if d["wireless"] and any(d["serial"].startswith(a + ":") for a in device["addresses"]):
                return d
        return None

    def _add_camera_rows(self, expander, device):
        stream = self._cam.info()
        own_stream = stream if stream and (stream["serial"].split(":")[0] in device["addresses"] or not stream["wireless"]) else None
        usb = [d for d in self._usb_phones() if d["state"] == "device"]
        connected = self._wireless_device_for(device)
        wireless_ready = connected is not None and connected["state"] == "device"
        service_seen = ls.connect_service_for(self._adb_services, device["addresses"]) is not None
        status = ls.webcam_status("pipewire", own_stream, bool(usb), wireless_ready, service_seen)
        cam_row = info_row(expander, "Camera", "camera-web-symbolic", status)
        cam_row.set_subtitle_lines(3)
        button_row(expander, "Use as a Webcam…", "camera-web-symbolic", lambda *_: self._on_phone_webcam(device))
        if not wireless_ready and not own_stream:
            button_row(expander, "Set Up Wireless…", "network-wireless-symbolic", lambda *_: self._on_phone_wireless_setup(device))
        if own_stream:
            button_row(expander, "Stop the Camera", "media-playback-stop-symbolic", lambda *_: self._stop_camera(), "destructive-action")

    def _set_usb_camera_rows(self):
        for row in self._usb_rows:
            self._phone_usb_group.remove(row)
        self._usb_rows = []
        phones = self._usb_phones()
        show = bool(phones) or not os.path.exists(KDECONNECTD)
        self._phone_usb_group.set_visible(show)
        if not show:
            return
        for d in phones:
            label = d["model"] or d["serial"]
            if d["state"] == "device":
                row = Adw.ActionRow(title=label, subtitle="Connected over USB and authorized")
                button = Gtk.Button(label="Use as a Webcam…", valign=Gtk.Align.CENTER)
                button.connect("clicked", lambda *_, t={"serial": d["serial"], "label": label, "wireless": False}: self._open_camera(t))
                row.add_suffix(button)
            elif d["state"] == "unauthorized":
                row = Adw.ActionRow(title=label, subtitle="Accept the USB debugging prompt on the phone")
            else:
                row = Adw.ActionRow(title=label, subtitle=f"adb says {d['state']}")
            row.add_prefix(icon("phone-symbolic"))
            self._phone_usb_group.add(row)
            self._usb_rows.append(row)
        if not phones:
            row = Adw.ActionRow(title="No phone on the cable", subtitle="USB debugging on, a data cable, and the prompt accepted on the phone")
            row.add_prefix(icon("phone-symbolic"))
            self._phone_usb_group.add(row)
            self._usb_rows.append(row)

    def _orientations_for(self, serial):
        """{facing: degrees} of a phone's camera sensors, asked once per
        phone. Blocking: call from a thread."""
        if serial not in self._cam_orientations:
            rc, out, _ = run([ADB, "-s", serial, "shell", "dumpsys", "media.camera"], timeout=15)
            found = ls.camera_orientations(out) if rc == 0 else {}
            if found:
                self._cam_orientations[serial] = found
        return self._cam_orientations.get(serial, {})

    def _open_camera(self, target):
        if self._cam.running and self._cam.serial != target["serial"]:
            self._toast(f"The camera is already streaming from {self._cam.label}: stop it first")
            return
        self._cam_dialog = CameraDialog(self, target)
        self._cam_dialog.present(self)

    def _stop_camera(self):
        self._cam.restarting = False
        self._cam.stop()
        self._toast("Camera stopped")
        self._phone_refresh_soon()

    def _on_stream_end(self, mode, why):
        if not self._cam.restarting:
            self._toast(("The camera stopped: " if mode == "camera" else "The microphone stopped: ") + why)
            self._phone_refresh_soon()

    def _on_stream_state(self, _mode, _state):
        # Streaming, switching the lens, reconnecting: the card and the dialog follow.
        self._phone_refresh_soon()
        if self._cam_dialog is not None:
            self._cam_dialog._sync()

    def _on_phone_webcam(self, device):
        """USB first; then a connection already there over the network; then
        the wireless debugging service adb sees for this phone."""
        usb = [d for d in self._usb_phones() if d["state"] == "device"]
        if usb:
            self._open_camera({"serial": usb[0]["serial"], "label": device["name"], "wireless": False})
            return
        already = self._wireless_device_for(device)
        if already and already["state"] == "device":
            self._open_camera({"serial": already["serial"], "label": device["name"], "wireless": True})
            return
        service = ls.connect_service_for(self._adb_services, device["addresses"])
        if service is None:
            self._phone_wireless_off(device)
            return
        serial = f"{service['host']}:{service['port']}"

        def worker():
            rc, out, err = run([ADB, "connect", serial], timeout=30)
            verdict = ls.adb_result(out + err, rc)
            on_main(self._after_connect, device, serial, verdict)

        in_thread(worker)

    def _after_connect(self, device, serial, verdict):
        if verdict == "ok":
            self._open_camera({"serial": serial, "label": device["name"], "wireless": True})
        elif verdict == "not-paired":
            self._on_phone_wireless_setup(device)
        else:
            self._toast("The phone did not answer over Wi-Fi: is wireless debugging on?")

    def _phone_wireless_off(self, device):
        if self._wireless_device_for(device) is None and not device["addresses"]:
            self._toast("The phone is not on the network right now")
            return

        def remind():
            def worker():
                self._kdec_call(device["path"] + "/ping", "org.kde.kdeconnect.device.ping", "sendPing",
                                GLib.Variant("(s)", ("Lucciola: turn on Wireless debugging (Developer options) to use the camera",)))
                on_main(self._toast, "Reminder sent to the phone")

            in_thread(worker)

        self._confirm(
            "Wireless Debugging Is Off on the Phone",
            "The camera over Wi-Fi needs Wireless debugging on (Settings, System, Developer options; the quick settings tile does it in one tap). "
            "A reminder can be sent to the phone now. Over USB, plug the cable and press Use as a Webcam again.",
            "Send a Reminder", remind,
        )

    def _on_phone_wireless_setup(self, device):
        """Pairing with the phone's wireless debugging, once per phone: a QR
        code the phone scans (Pair device with QR code), or the six-digit
        code typed here (Pair device with pairing code)."""
        import secrets
        name = f"lucciola-{secrets.token_hex(2)}"
        password = secrets.token_urlsafe(9)
        page = preferences_page()
        qr_group = Adw.PreferencesGroup(
            title="Scan With the Phone",
            description="On the phone: Settings, System, Developer options, Wireless debugging, then Pair device with QR code, and point it at this.",
        )
        page.add(qr_group)
        picture = Gtk.Picture()
        picture.set_size_request(-1, 260)
        picture.set_can_shrink(True)
        qr_group.add(picture)
        self._qr_status = Adw.ActionRow(title="Waiting for the phone to scan…")
        self._qr_status.add_prefix(spinner(16))
        qr_group.add(self._qr_status)
        code_group = Adw.PreferencesGroup(
            title="Or Type the Code",
            description="On the phone, Pair device with pairing code shows a port and six digits.",
        )
        page.add(code_group)
        host = Adw.EntryRow(title="Phone address")
        host.set_text(device["addresses"][0] if device["addresses"] else "")
        port = Adw.EntryRow(title="Pairing port")
        port.set_input_purpose(Gtk.InputPurpose.DIGITS)
        code = Adw.EntryRow(title="Pairing code")
        code.set_input_purpose(Gtk.InputPurpose.DIGITS)
        for row in (host, port, code):
            code_group.add(row)
        pair_button = button_row(code_group, "Pair With the Code", "network-wireless-symbolic", lambda *_: self._pair_typed(device, host, port, code))
        pair_button.set_sensitive(False)
        for row in (host, port, code):
            row.connect("changed", lambda *_: pair_button.set_sensitive(ls.pair_input_ok(host.get_text().strip(), port.get_text().strip(), code.get_text().strip())))
        note = Adw.PreferencesGroup()
        page.add(note)
        info_row(note, "A Permission of Its Own", "dialog-information-symbolic",
                 "Different from KDE Connect's: it lets this PC drive the phone, for the camera and the microphone. The phone lists it under Wireless debugging and can revoke it there.")
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(page)
        dialog = Adw.Dialog()
        dialog.set_title("Set Up the Camera Over Wi-Fi")
        dialog.set_content_width(520)
        dialog.set_content_height(760)
        dialog.set_child(toolbar)
        state = {"open": True, "done": False}
        dialog.connect("closed", lambda *_: state.update(open=False))
        dialog.present(self)
        self._qr_dialog = dialog
        in_thread(self._qr_render, picture, name, password)
        in_thread(self._qr_watch, device, name, password, state)

    def _qr_render(self, picture, name, password):
        payload = ls.qr_pairing_payload(name, password)
        rc, out, err = run([QRENCODE, "-o", "-", "-t", "PNG", "-s", "8", "-m", "2", payload], timeout=15)
        if rc != 0:
            on_main(self._qr_status.set_title, "The QR code could not be drawn: type the code instead")
            return
        import subprocess as _sp
        try:
            png = _sp.run([QRENCODE, "-o", "-", "-t", "PNG", "-s", "8", "-m", "2", payload], capture_output=True, timeout=15, check=True).stdout
            texture = Gdk.Texture.new_from_bytes(GLib.Bytes.new(png))
        except (OSError, _sp.SubprocessError, GLib.Error):
            on_main(self._qr_status.set_title, "The QR code could not be drawn: type the code instead")
            return
        on_main(picture.set_paintable, texture)

    def _qr_watch(self, device, name, password, state):
        """After the scan the phone advertises a pairing service with the
        name from the QR: pair with it, then connect."""
        deadline = time.monotonic() + 180
        while state["open"] and time.monotonic() < deadline:
            _, out, _ = run([ADB, "mdns", "services"], timeout=10)
            service = ls.pairing_service_for(ls.mdns_services(out), name)
            if service is not None:
                on_main(self._qr_status.set_title, "Pairing…")
                rc, out, err = run([ADB, "pair", f"{service['host']}:{service['port']}", password], timeout=60)
                verdict = ls.adb_result(out + err, rc)
                state["done"] = True
                on_main(self._pair_finished, device, verdict, ls.last_line(out + err))
                return
            time.sleep(2)
        if state["open"]:
            on_main(self._qr_status.set_title, "No scan in three minutes: open the dialog again, or type the code")

    def _pair_typed(self, device, host, port, code):
        h, p, c = host.get_text().strip(), port.get_text().strip(), code.get_text().strip()

        def worker():
            rc, out, err = run([ADB, "pair", f"{h}:{p}", c], timeout=60)
            on_main(self._pair_finished, device, ls.adb_result(out + err, rc), ls.last_line(out + err))

        in_thread(worker)

    def _pair_finished(self, device, verdict, detail):
        dialog = getattr(self, "_qr_dialog", None)
        if dialog is not None:
            dialog.close()
            self._qr_dialog = None
        self._after_pair(device, verdict, detail)

    def _after_pair(self, device, verdict, detail):
        if verdict == "ok":
            self._toast("Paired: the phone connects over Wi-Fi from now on")
            self._refresh_phone()
            GLib.timeout_add(1500, lambda: (self._on_phone_webcam(device), False)[1])
        else:
            self._toast(f"Pairing did not work: {detail or 'check the port and the code'}")

    # ══════════════════════ help, report, about ═════════════════════

    def _on_help(self):
