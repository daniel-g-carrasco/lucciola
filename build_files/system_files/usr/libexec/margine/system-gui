        # ── sidebar ──────────────────────────────────────────────────
        side_toolbar = Adw.ToolbarView()
        side_header = Adw.HeaderBar()
        side_header.set_title_widget(Adw.WindowTitle(title="Lucciola System"))
        menu = Gio.Menu()
