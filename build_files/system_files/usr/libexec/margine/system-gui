    # ═════════════════════════════ Features ═════════════════════════

    def _build_features(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self._restart_banner = Adw.Banner(title="A restart finishes the change to the system packages")
        self._restart_banner.set_button_label("Restart…")
        self._restart_banner.connect("button-clicked", lambda *_: self._reboot())
        self._restart_banner.set_revealed(False)
        box.append(self._restart_banner)
        page = preferences_page()
        page.set_vexpand(True)
        box.append(page)
        self._feature_rows = {}
        for group_name, description in FEATURE_GROUPS:
            group = Adw.PreferencesGroup(title=group_name, description=description)
            page.add(group)
            for spec in FEATURE_SPECS:
                if spec["group"] != group_name:
                    continue
                title = spec["title"] + (" (experimental)" if spec.get("experimental") else "")
                row = Adw.ActionRow(title=title)
                row.add_prefix(icon(spec["icon"]))
                row.set_subtitle_lines(3)
                install = Gtk.Button(label="Install…", valign=Gtk.Align.CENTER)
                install.connect("clicked", self._on_feature_install, spec["key"])
                remove = Gtk.Button(label="Remove…", valign=Gtk.Align.CENTER)
                remove.connect("clicked", self._on_feature_remove, spec["key"])
                for button in (install, remove):
                    button.set_visible(False)
                    row.add_suffix(button)
                row._install, row._remove = install, remove
                self._set_loading(row, True)
                group.add(row)
                self._feature_rows[spec["key"]] = row
        return box

    def _refresh_features(self):
        gen = self._bump("features")
        for row in self._feature_rows.values():
            self._set_loading(row, True)
            row._install.set_visible(False)
            row._remove.set_visible(False)

        def worker():
            rc, out, err = run([FEATURE, "all", "status"], timeout=90)
            statuses = ls.feature_statuses(out) if rc == 0 else {}
            rc2, st_out, _ = run(["rpm-ostree", "status", "--json"])
            state = ls.parse_deployments(st_out if rc2 == 0 else "")
            _, lspci, _ = run(["lspci"])
            on_main(self._set_features, gen, statuses, state, ls.amd_gpu(lspci), err if rc != 0 else "")

        in_thread(worker)

    def _set_features(self, gen, statuses, state, amd, error):
        if not self._current("features", gen):
            return
        self._features = statuses
        self._amd_gpu = amd
        unknown = {"state": "unknown", "detail": ""}
        pending = bool(state.get("staged"))
        for spec in FEATURE_SPECS:
            key = spec["key"]
            row = self._feature_rows[key]
            st = statuses.get(key, unknown)
            if key == "gaming":
                st = ls.gaming_state(st, statuses.get("gaming-native", unknown))
            self._set_loading(row, False)
            label = ls.FEATURE_STATE_LABELS[st["state"]]
            detail = st.get("detail") or (ls.last_line(error) if error else "")
            row.set_subtitle(f"{label}. {detail}" if detail else label)
            row._install.set_visible(st["state"] in ("absent", "partial", "unknown"))
            row._remove.set_visible(st["state"] in ("installed", "pending", "partial"))
            row._install.set_sensitive(not self._busy)
            row._remove.set_sensitive(not self._busy)
            if st["state"] == "pending":
                pending = True
        self._restart_banner.set_revealed(pending)

    def _spec(self, key):
        return next(s for s in FEATURE_SPECS if s["key"] == key)

    def _on_feature_install(self, _button, key):
        spec = self._spec(key)
        option = None
        extra = None
        if key == "gaming":
            option = Adw.SwitchRow(title="Native Variant", subtitle=spec["native"])
        elif key == "ai" and self._amd_gpu:
            option = Adw.SwitchRow(title="AMD GPU Acceleration", subtitle=spec["amd"])
            option.set_active(True)
        if option is not None:
            option.set_subtitle_lines(4)
            extra = Adw.PreferencesGroup()
            extra.add(option)
        body = spec["explain"]
        if spec["restart"]:
            body += " A restart is needed afterwards."

        def go():
            verb, args, then = f"{key}-on", [], None
            if key == "gaming" and option.get_active():
                verb = "gaming-native-on"
            if key == "ai" and option is not None and option.get_active():
                args = ["amd"]
            if key == "devmode":
                then = self._brew_install
            elif key == "sunshine":
                then = self._sunshine_user_setup
            self._run_operation(["pkexec", ADMIN, verb] + args, title=f"Installing {spec['title']}",
                                working=spec["working"], done=spec["done"], then=then)

        self._confirm(f"Install {spec['title']}?", body, "Install", go, extra=extra)

    def _brew_install(self, code):
        # Homebrew belongs to the user: never under pkexec.
        if code == 0:
            self._run_operation([DEVMODE, "brew-install"], title="Installing Homebrew",
                                working="Installing Homebrew in /home/linuxbrew, owned by you. No restart is needed for it.",
                                done="Homebrew installed: it works in new terminals")

    def _sunshine_user_setup(self, code):
        # The Flatpak override and Sunshine's own helper act on the user's session.
        if code == 0:
            run(["flatpak", "override", "--user", "--device=all", SUNSHINE_APP])
            self._run_operation(["flatpak", "run", "--command=additional-install.sh", SUNSHINE_APP],
                                title="Finishing Sunshine's Setup", working="Running Sunshine's own setup helper.",
                                done="Sunshine is ready: log out and back in once, then open it and pair your Moonlight client")

    def _on_feature_remove(self, _button, key):
        spec = self._spec(key)
        option = None
        extra = None
        if key == "devmode" and os.path.exists(BREW):
            option = Adw.SwitchRow(title="Also Delete Homebrew", subtitle="Everything installed with it goes too")
            extra = Adw.PreferencesGroup()
            extra.add(option)
        done = f"{spec['title']} removed" + (": restart to finish" if spec["restart"] else "")

        def privileged(_code=0):
            verb = f"{key}-off"
            if key == "gaming" and self._features.get("gaming-native", {}).get("state") in ("installed", "pending", "partial"):
                verb = "gaming-native-off"
            then = None
            if option is not None and option.get_active():
                then = self._brew_remove
            self._run_operation(["pkexec", ADMIN, verb], title=f"Removing {spec['title']}",
                                working=f"Removing {spec['title']}.", done=done, then=then)

        def go():
            if key == "sunshine":
                # Sunshine's own helper first, as the user; the system part follows either way.
