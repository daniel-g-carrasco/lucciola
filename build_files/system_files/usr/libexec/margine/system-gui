        side_toolbar.add_top_bar(side_header)
        self._sidebar = Gtk.ListBox()
        self._sidebar.add_css_class("navigation-sidebar")
        self._sidebar.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self._rows_by_page = {}
