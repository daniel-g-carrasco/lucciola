            self._set_loading(row, True)
        # Layered packages are the one part of the system that is NOT in
        # the image, so "am I current?" is a fair question about them too.
        self._layered_row = self._link_row(sys_group, "Extra Packages", "system-software-install-symbolic", self._on_show_layered)

        ch_group = Adw.PreferencesGroup(
            title="Apps and Tools",
            description="Apps update on their own twice a day, command-line tools once a week; nothing to do unless you want them sooner",
        )
        page.add(ch_group)
        self._flatpak_row = self._link_row(ch_group, "Apps", "view-grid-symbolic", self._on_show_flatpak)
        self._brew_row = self._link_row(ch_group, "Command-Line Tools", "utilities-terminal-symbolic", self._on_show_brew)

        care_group = Adw.PreferencesGroup(title="Health and Recovery")
        page.add(care_group)
        self._rollback_row = info_row(care_group, "Previous Version", "edit-undo-symbolic")
        self._set_loading(self._rollback_row, True)
        self._check_button = button_row(care_group, "Run System Check…", "emblem-system-symbolic", self._on_run_check)
        self._rollback_button = button_row(care_group, "Roll Back…", "edit-undo-symbolic", self._on_rollback, "destructive-action")
        self._rollback_button.set_sensitive(False)
        return page

    def _refresh_overview(self):
        gen = self._bump("overview")
        self._last_refresh = time.monotonic()
        self._latest = None
        self._latest_error = None
        self._update_hero()
        for row in (self._flatpak_row, self._brew_row):
            self._set_loading(row, True)

        def worker():
            rc, out, _ = run(["rpm-ostree", "status", "--json"])
            state = ls.parse_deployments(out if rc == 0 else "")
            on_main(self._set_state, gen, state)
            image = state.get("image") or ls.IMAGE
            rc, out, err = run(
                ["skopeo", "inspect", "--no-tags", f"docker://{image}", "--format",
                 "{{.Digest}} {{ index .Labels \"org.opencontainers.image.version\" }}"],
                timeout=60,
            )
            if rc == 0:
                version, digest = ls.parse_skopeo(out)
                on_main(self._set_latest, gen, version, digest, None)
            else:
                on_main(self._set_latest, gen, None, "", self._explain_fetch(rc))
            rc, out, _ = run(["flatpak", "remote-ls", "--updates", "--columns=name,application"], 90)
            flat = ls.app_updates(out) if rc == 0 else None
            brew = None  # None = unavailable, [] = nothing outdated
            if os.path.exists(BREW):
                env = dict(os.environ, HOMEBREW_NO_AUTO_UPDATE="1")
                rc, out, _ = run([BREW, "outdated", "--quiet"], 90, env=env)
                if rc == 0:
                    brew = [x.strip() for x in out.splitlines() if x.strip()]
            excluded = ls.excluded_apps(read_file(BLOCKED))
            on_main(self._set_counts, gen, flat, brew, excluded)

        in_thread(worker)

    def _explain_fetch(self, rc):
        if not Gio.NetworkMonitor.get_default().get_network_available():
            return "This machine is offline"
        if rc == -2:
            return "The image registry took too long to answer"
        if rc == -1:
            return "The tool that asks the registry is missing"
        return "The image registry could not be reached"

    def _set_state(self, gen, state):
        if not self._current("overview", gen):
            return
        self._state = state
        booted = state.get("booted") or "unknown"
        for row, text in (
            (self._version_row, booted),
            (self._kernel_row, os.uname().release),
            (self._base_row, "Fedora → Universal Blue main → Lucciola"),
        ):
            self._set_loading(row, False)
            row.set_subtitle(text)
        layered = state.get("layered") or []
        self._set_loading(self._layered_row, False)
        self._layered_row.set_subtitle(ls.layered_phrase(layered))
        self._layered_row.set_activatable(bool(layered))
        rollback = state.get("rollback")
        self._set_loading(self._rollback_row, False)
        if rollback:
            self._rollback_row.set_subtitle(f"{rollback}, kept on this machine")
            self._rollback_button.set_sensitive(not self._busy)
        else:
            self._rollback_row.set_subtitle("None yet: the first update keeps one")
            self._rollback_button.set_sensitive(False)
        self._update_hero()

    def _set_latest(self, gen, latest, latest_digest, error):
        if not self._current("overview", gen):
            return
        self._latest = latest
        self._latest_digest = latest_digest or ""
        self._latest_error = error
        self._update_hero()

    def _set_counts(self, gen, flat, brew, excluded):
        if not self._current("overview", gen):
            return
        self._flatpak_updates = flat
        self._brew_updates = brew
        self._excluded = excluded
        self._set_loading(self._flatpak_row, False)
        self._set_loading(self._brew_row, False)
        subtitle = ls.waiting_phrase(flat, "apps", unavailable="Could not ask Flathub")
        if excluded:
            subtitle += f"; {len(excluded)} excluded from automatic updates"
        self._flatpak_row.set_subtitle(subtitle)
        self._flatpak_row.set_activatable(True)
        if os.path.exists(BREW):
            self._brew_row.set_subtitle(ls.waiting_phrase(brew, "tools", unavailable="Could not ask Homebrew"))
        else:
            self._brew_row.set_subtitle("Homebrew is not installed")
        self._brew_row.set_activatable(True)

    def _update_hero(self):
        staged = self._state.get("staged")
        booted = self._state.get("booted") or "unknown"
        self._hero_version.set_text(staged or (booted if self._state else ""))
        self._hero_icon.remove_css_class("accent")
        self._hero_icon.remove_css_class("warning")
        if staged:
            self._show_hero_icon("system-reboot-symbolic", "accent")
            self._hero_title.set_text("Restart to Finish")
            self._hero_body.set_text(f"This version is downloaded and waiting. {booted} keeps running until you restart.")
            self._set_action("Restart Now", suggested=True)
            return
        if not self._state or (self._latest is None and self._latest_error is None):
            self._hero_stack.set_visible_child_name("spinner")
            self._hero_title.set_text("Checking for Updates")
            self._hero_body.set_text("Asking the registry which version is published…")
            self._action_button.set_visible(False)
            return
        if self._latest_error:
            self._show_hero_icon("network-offline-symbolic", "warning")
            self._hero_title.set_text("Could Not Check for Updates")
            self._hero_body.set_text(f"{self._latest_error}. {booted} is what this machine runs.")
            self._set_action("Try Again", suggested=False)
            return
        if ls.update_available(self._state, self._latest, self._latest_digest):
            self._show_hero_icon("software-update-available-symbolic", None)
            self._hero_title.set_text("Update Available")
            if booted == self._latest:
                self._hero_body.set_text(
                    f"A newer build of {self._latest} is published. Two builds can share a version "
                    "label on the same day; this machine runs the older one."
                )
            else:
                self._hero_body.set_text(f"This machine runs {booted}. The published version is {self._latest}.")
            self._set_action("Download Update", suggested=True)
            return
        self._show_hero_icon("object-select-symbolic", None)
        self._hero_title.set_text("Up to Date")
        self._hero_body.set_text(f"This machine matches the latest published version. Checked at {time.strftime('%H:%M')}.")
        self._set_action("Check Again", suggested=False)

    def _show_hero_icon(self, name, css):
        self._hero_icon.set_from_icon_name(name)
        if css:
            self._hero_icon.add_css_class(css)
        self._hero_stack.set_visible_child_name("icon")

    def _set_action(self, label, suggested):
        self._action_button.set_label(label)
        self._action_button.remove_css_class("suggested-action")
        if suggested:
            self._action_button.add_css_class("suggested-action")
        self._action_button.set_sensitive(not self._busy)
        self._action_button.set_visible(True)

    def _on_show_layered(self, _row):
        self._list_dialog(
            "Extra Packages",
            "Installed on top of the image, usually by the gaming feature. They are "
            "re-resolved from the repositories with every system update, so they stay current with it.",
            self._state.get("layered") or [], "No extra packages",
        )

    def _on_show_flatpak(self, _row):
        extra = []
        apps = self._flatpak_updates or []
        if apps:
            group = Adw.PreferencesGroup()
            button_row(group, "Update Apps Now", "software-update-available-symbolic", self._on_update_apps, "suggested-action")
            extra.append(group)
        if self._excluded:
            group = Adw.PreferencesGroup(
                title="Excluded From Automatic Updates",
                description="Their downloads kept hanging the unattended updates, so the update "
                            "watchdog set them aside. Updating one here takes it back in.",
            )
            for app_id, since in self._excluded:
                row = Adw.ActionRow(title=app_id, subtitle=f"Since {since}" if since else "")
                row.add_prefix(icon("dialog-warning-symbolic"))
                button = Gtk.Button(label="Update Now", valign=Gtk.Align.CENTER)
                button.connect("clicked", self._on_unblock, app_id)
                row.add_suffix(button)
                group.add(row)
            extra.append(group)
        if self._flatpak_updates is None:
            description = "Flathub could not be asked right now. Apps still update on their own at 04:30 and 16:30."
        else:
            description = ("Flatpak apps with an update waiting. They install on their own at 04:30 and 16:30 "
                           "(your own apps at 17:00); Update Apps Now does it right away.")
        self._apps_dialog = self._list_dialog("App Updates", description, apps, "All apps are up to date", extra=extra)

    def _on_show_brew(self, _row):
        if not os.path.exists(BREW):
            self._list_dialog(
                "Command-Line Tools",
                "Homebrew is not installed on this machine. It comes with the developer tools feature, "
                "together with VS Code and a compiler.", [], "Nothing to update",
            )
            return
        extra = []
        if self._brew_updates:
            group = Adw.PreferencesGroup()
            button_row(group, "Update Command-Line Tools", "software-update-available-symbolic", self._on_brew_update, "suggested-action")
            extra.append(group)
        self._brew_dialog = self._list_dialog(
            "Command-Line Tools",
            "Homebrew packages with a newer version available. They upgrade weekly on their own; "
            "Update Command-Line Tools does it right away.",
            self._brew_updates or [], "All tools are up to date", extra=extra,
        )

    def _on_primary_action(self, _button):
        if self._state.get("staged"):
            self._reboot()
        elif self._latest_error:
            self._refresh_overview()
        elif ls.update_available(self._state, self._latest, self._latest_digest):
            self._run_operation(
                ["pkexec", ADMIN, "update"], title="Downloading Update",
                working="Downloading the next version. The machine keeps working meanwhile.",
                done="Update downloaded: restart to finish it",
            )
        else:
            self._refresh_overview()

    def _close_dialog(self, name):
        dialog = getattr(self, name, None)
        if dialog is not None:
            dialog.close()
            setattr(self, name, None)

    def _on_update_apps(self, _row):
        # No pkexec: flatpak asks polkit itself for the system installation,
        # and an active user may update without a password.
        self._close_dialog("_apps_dialog")
        self._run_operation(
            ["flatpak", "update", "-y", "--noninteractive"], title="Updating Apps",
            working="Updating the apps with a newer version on Flathub.", done="Apps updated",
        )

    def _on_unblock(self, _button, app_id):
        self._close_dialog("_apps_dialog")
        self._run_operation(
            ["pkexec", ADMIN, "flatpak-unblock", app_id], title=f"Updating {app_id}",
            working=f"Updating {app_id} and taking it back into automatic updates.",
            done=f"{app_id} updated and back in automatic updates",
        )

    def _on_brew_update(self, _row):
        # No pkexec here on purpose: brew's prefix belongs to the user and
        # brew refuses to run as root.
        self._close_dialog("_brew_dialog")
        self._run_operation(
            [BREW_UPGRADE], title="Updating Command-Line Tools",
            working="Upgrading the Homebrew packages with a newer version.", done="Command-line tools updated",
        )

    def _reboot(self):
        self._confirm(
            "Restart Now?", "Open apps will be closed. The update is applied while restarting.",
            "Restart", lambda: subprocess.Popen(["systemctl", "reboot"]),
        )

    def _on_rollback(self, _row):
        target = self._state.get("rollback") or "the previous version"
        self._confirm(
            "Roll Back?",
            f"The next restart will boot {target} instead of the current version. "
            "Your files and settings are not touched, and you can roll forward again by updating.",
            "Roll Back",
            lambda: self._run_operation(
                ["pkexec", ADMIN, "rollback"], title="Rolling Back",
                working=f"Making {target} the version that starts next.",
                done="Rolled back: restart to boot the previous version",
            ),
            destructive=True,
        )

    def _on_run_check(self, _row):
        self._check_button.set_sensitive(False)
        self._check_button.set_title("Running the System Check…")

        def worker():
            results = []
            validators = sorted(p for p in os.listdir("/usr/bin") if p.startswith("lucciola-validate-"))
            for name in validators:
                path = f"/usr/bin/{name}"
                rc, out, err = run([path], timeout=180)
                detail = (out + err).strip() if rc != -1 else "the check could not start"
                if rc == -2:
                    detail = "the check did not finish"
                results.append((ls.check_name(path), rc == 0, detail))
            on_main(self._show_check_results, results)

        in_thread(worker)

    def _show_check_results(self, results):
        self._check_button.set_sensitive(True)
        self._check_button.set_title("Run System Check…")
        self._check_results = results
        if not results:
            self._toast("No checks are installed on this system")
            return
        page = preferences_page()
        group = Adw.PreferencesGroup(title="System Check", description=ls.check_summary(results))
        page.add(group)
        for name, ok, detail in results:
            row = Adw.ActionRow(title=name)
            row.add_prefix(icon("object-select-symbolic" if ok else "dialog-warning-symbolic"))
            if not ok and detail:
                row.set_subtitle(ls.last_line(detail))
                row.set_subtitle_lines(3)
            group.add(row)
        actions = Adw.PreferencesGroup()
        button_row(actions, "Copy Results", "edit-copy-symbolic", self._on_copy_results)
        page.add(actions)
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(page)
        dialog = Adw.Dialog()
        dialog.set_title("System Check")
        dialog.set_content_width(520)
        dialog.set_content_height(600)
        dialog.set_child(toolbar)
        dialog.present(self)

    def _on_copy_results(self, _row):
        text = "\n\n".join(f"== {name}: {'OK' if ok else 'FAIL'} ==\n{detail}".rstrip() for name, ok, detail in self._check_results)
        Gdk.Display.get_default().get_clipboard().set(text)
        self._toast("Results copied")

    # ══════════════════════ Startup & Security ══════════════════════

    def _build_startup(self):
        page = preferences_page()

        sb_group = Adw.PreferencesGroup(
            title="Secure Boot",
            description="With Secure Boot on, the firmware starts only systems whose key it knows. Lucciola's kernels are signed with its own key, which has to be registered once.",
        )
        page.add(sb_group)
        self._sb_row = info_row(sb_group, "Secure Boot", "security-high-symbolic")
        self._mok_row = info_row(sb_group, "Lucciola's Key", "dialog-password-symbolic")
        self._mok_enroll_button = button_row(sb_group, "Register the Key at the Next Restart…", "dialog-password-symbolic", self._on_mok_enroll, "suggested-action")
        self._mok_never_button = button_row(sb_group, "Stop Reminding Me", "window-close-symbolic", self._on_mok_never)

        disk_group = Adw.PreferencesGroup(
            title="Disk Unlock",
            description="An encrypted disk normally asks its passphrase at every startup. The TPM security chip can unlock it instead, as long as the system that starts is the one it knows: Secure Boot on, Lucciola's key registered.",
        )
        page.add(disk_group)
        self._tpm_row = info_row(disk_group, "Disk Unlock at Startup", "drive-harddisk-symbolic")
        self._tpm_enable_button = button_row(disk_group, "Let the TPM Unlock the Disk…", "drive-harddisk-symbolic", self._on_tpm_enable, "suggested-action")
        self._tpm_disable_button = button_row(disk_group, "Ask the Passphrase at Startup Again…", "drive-harddisk-symbolic", self._on_tpm_disable, "destructive-action")

        boot_group = Adw.PreferencesGroup(
            title="Boot Menu",
            description="The boot menu can change how the system starts. Locked, editing it needs a password; normal starts and going back to a previous version never do.",
        )
        page.add(boot_group)
        self._grub_row = info_row(boot_group, "Boot Menu Lock", "system-lock-screen-symbolic")
        self._grub_on_button = button_row(boot_group, "Lock the Boot Menu…", "system-lock-screen-symbolic", self._on_grub_on, "suggested-action")
        self._grub_off_button = button_row(boot_group, "Remove the Lock…", "system-lock-screen-symbolic", self._on_grub_off, "destructive-action")
        info_row(boot_group, "Large Boot Menu on HiDPI Screens", "video-display-symbolic", "Applied on its own at every start")

        kernel_group = Adw.PreferencesGroup(
            title="Kernel",
            description="Lucciola runs the CachyOS kernel. A second version, the same in everything else, runs Fedora's own kernel: it starts on processors without x86-64-v3, and it is the way out if a CachyOS kernel update misbehaves on this machine.",
        )
        page.add(kernel_group)
        self._kernel_running_row = info_row(kernel_group, "Running Now", "computer-symbolic")
        self._kernel_follows_row = info_row(kernel_group, "Follows", "package-x-generic-symbolic")
        self._kernel_switch_button = button_row(kernel_group, "Switch to Fedora's Kernel…", "system-reboot-symbolic", self._on_kernel_switch)
        return page

    def _refresh_startup(self):
        gen = self._bump("startup")
        for row in (self._sb_row, self._mok_row, self._tpm_row, self._grub_row, self._kernel_running_row, self._kernel_follows_row):
            self._set_loading(row, True)
        for b in (self._mok_enroll_button, self._mok_never_button, self._tpm_enable_button, self._tpm_disable_button,
                  self._grub_on_button, self._grub_off_button, self._kernel_switch_button):
            b.set_sensitive(False)

        def worker():
            _, sb_out, _ = run(["mokutil", "--sb-state"])
            _, mok_out, _ = run([MOK_ENROLL, "status"])
            sb = ls.secureboot_state(sb_out, mok_out)
            on_main(self._set_secureboot, gen, sb)
            # Read-only verbs: their polkit action lets an active user in without a password.
            rc, out, err = run(["pkexec", ADMIN, "tpm-unlock-status"], timeout=60)
            tpm = ls.parse_tpm_status(out + err)
            on_main(self._set_tpm, gen, tpm, rc, sb)
            rc, out, err = run(["pkexec", ADMIN, "grub-lock-status"], timeout=60)
            on_main(self._set_grub, gen, ls.parse_grub_lock(out + err), rc)
            rc, out, _ = run(["rpm-ostree", "status", "--json"])
            state = ls.parse_deployments(out if rc == 0 else "")
            kernel = ls.kernel_state(state, read_file(KERNEL_FLAVOUR_FILE), read_file(KERNEL_RESERVE_FILE))
            on_main(self._set_kernel, gen, kernel)

        in_thread(worker)

    def _set_secureboot(self, gen, sb):
        if not self._current("startup", gen):
            return
        self._sb_state = sb
        self._set_loading(self._sb_row, False)
        self._set_loading(self._mok_row, False)
        on = sb["secure_boot"]
        self._sb_row.set_subtitle(
            "On: the firmware starts only signed systems" if on else
            "Off: any system can start on this machine" if on is False else
            "Unknown: the firmware did not say"
        )
        key = sb["key"]
        self._mok_row.set_subtitle({
            "enrolled": "Registered: Lucciola's kernels start with Secure Boot on",
            "pending": "Registration waits for the next restart: a blue screen asks to confirm it (the password is margine)",
            "absent": "Not registered: Secure Boot must stay off until it is",
            "unsupported": "Not applicable on this machine",
        }[key])
        self._mok_enroll_button.set_sensitive(key == "absent" and not self._busy)
        self._mok_enroll_button.set_visible(key == "absent")
        self._mok_never_button.set_sensitive(key == "absent" and not self._busy)
        self._mok_never_button.set_visible(key == "absent")

    def _set_tpm(self, gen, tpm, rc, sb):
        if not self._current("startup", gen):
            return
        self._tpm = tpm
        self._set_loading(self._tpm_row, False)
        if rc in (126, 127):
            state, text = "unknown", "Not allowed to read how the disk is unlocked"
        else:
            state, text = ls.tpm_summary(tpm)
        self._tpm_state = state
        self._tpm_row.set_subtitle(text)
        can_enable = state in ("off", "half") and sb["secure_boot"] and sb["key"] == "enrolled"
        self._tpm_enable_button.set_visible(state in ("off", "half", "unknown"))
        self._tpm_enable_button.set_sensitive(bool(can_enable) and not self._busy)
        if state in ("off", "half") and not can_enable:
            self._tpm_row.set_subtitle(text + ". Secure Boot on and the key registered come first")
        self._tpm_disable_button.set_visible(state in ("on", "half"))
        self._tpm_disable_button.set_sensitive(state in ("on", "half") and not self._busy)

    def _set_grub(self, gen, lock, rc):
        if not self._current("startup", gen):
            return
        self._set_loading(self._grub_row, False)
        if rc in (126, 127):
            lock = None
        self._grub_row.set_subtitle({
            "on": "Locked: editing the boot menu needs the password (user root)",
            "off": "Open: anyone at the keyboard can change how the system starts",
            "unavailable": "Not available: this boot menu does not read a lock",
            None: "Could not read the lock",
        }[lock])
        self._grub_on_button.set_visible(lock in ("off", None))
        self._grub_on_button.set_sensitive(lock == "off" and not self._busy)
        self._grub_off_button.set_visible(lock == "on")
        self._grub_off_button.set_sensitive(lock == "on" and not self._busy)

    def _set_kernel(self, gen, kernel):
        if not self._current("startup", gen):
            return
        self._kernel = kernel
        self._set_loading(self._kernel_running_row, False)
        self._set_loading(self._kernel_follows_row, False)
        names = {"cachyos": "the CachyOS kernel", "fedora": "Fedora's kernel", None: "a kernel this app does not recognise"}
        self._kernel_running_row.set_subtitle(f"{names[kernel['running']].capitalize()}, {os.uname().release}")
        follows = kernel["follows"]
        if follows:
            text = f"{follows}: {names[kernel['follows_flavour']]}"
            if kernel["staged"]:
                text += f". Staged for the next restart: {kernel['staged']} ({names[kernel['staged_flavour'] or kernel['follows_flavour']]})"
            self._kernel_follows_row.set_subtitle(text)
        else:
            self._kernel_follows_row.set_subtitle("A digest pin or another image: the kernel cannot be switched from here")
        target = "cachyos" if kernel["follows_flavour"] == "fedora" else "fedora"
        self._kernel_switch_button.set_title("Switch to the CachyOS Kernel…" if target == "cachyos" else "Switch to Fedora's Kernel…")
        self._kernel_switch_button.set_sensitive(bool(follows) and not kernel["staged"] and not self._busy)

    def _on_mok_enroll(self, _row):
        self._confirm(
            "Register Lucciola's Key?",
            "At the next restart the firmware shows a blue screen for a few seconds: choose Enroll MOK, "
            "Continue, Yes, and type the password margine. After that, Secure Boot can be turned on in the firmware settings.",
            "Register at the Next Restart",
            lambda: self._run_operation(["pkexec", ADMIN, "secureboot-enroll"], title="Registering the Key",
                                        working="Staging the key for the firmware.", done="The key is staged: the next restart asks to confirm it"),
        )

    def _on_mok_never(self, _row):
        self._confirm(
            "Stop the Reminders?",
            "Lucciola stops asking to register its key. Secure Boot must then stay off on this machine.",
            "Stop Reminding Me",
            lambda: self._run_operation(["pkexec", ADMIN, "secureboot-never"], title="Stopping the Reminders",
                                        working="Recording the choice.", done="No more reminders about the key"),
            destructive=True,
        )

    def _on_tpm_enable(self, _row):
        entry = Adw.PasswordEntryRow(title="Current disk passphrase")
        group = Adw.PreferencesGroup()
        group.add(entry)
        dialog = self._confirm(
            "Let the TPM Unlock the Disk?",
            "The disk passphrase keeps working. From the next startup the TPM unlocks the disk when the system "
            "is the one it knows; after a kernel switch or a firmware change it asks the passphrase once, and this "
            "page lets the TPM in again.",
            "Enable", lambda: self._run_operation(
                ["pkexec", ADMIN, "tpm-unlock-enable"], title="Enrolling the TPM",
                working="Enrolling the TPM on the encrypted disk and wiring the startup.",
                done="The TPM unlocks the disk from the next startup", stdin_text=entry.get_text() + "\n",
            ),
            extra=group,
        )
        dialog.set_response_enabled("go", False)
        entry.connect("changed", lambda e: dialog.set_response_enabled("go", bool(e.get_text())))

    def _on_tpm_disable(self, _row):
        self._confirm(
            "Ask the Passphrase at Every Startup?",
            "The TPM key is removed from the disk. Your passphrase is untouched and unlocks it at every startup.",
            "Disable",
            lambda: self._run_operation(["pkexec", ADMIN, "tpm-unlock-disable"], title="Removing the TPM Key",
                                        working="Removing the TPM key from the disk.", done="The passphrase is asked at every startup again"),
            destructive=True,
        )

    def _on_grub_on(self, _row):
        first = Adw.PasswordEntryRow(title="Boot menu password")
        second = Adw.PasswordEntryRow(title="Again")
        hint = Gtk.Label(label="Letters and digits only, at least eight. The boot menu reads the keyboard as a US layout; the user name is root.", xalign=0)
        hint.add_css_class("dimmed")
        hint.set_wrap(True)
        group = Adw.PreferencesGroup()
        group.add(first)
        group.add(second)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.append(group)
        box.append(hint)
        dialog = self._confirm(
            "Lock the Boot Menu?",
            "Changing how the system starts will need this password. Normal starts, and choosing a previous version, never ask for it.",
            "Lock", lambda: self._run_operation(
                ["pkexec", ADMIN, "grub-lock-on"], title="Locking the Boot Menu",
                working="Writing the boot menu password.", done="The boot menu is locked", stdin_text=first.get_text() + "\n",
            ),
            extra=box,
        )
        dialog.set_response_enabled("go", False)

        def validate(*_a):
            ok = ls.grub_password_ok(first.get_text()) and first.get_text() == second.get_text()
            dialog.set_response_enabled("go", ok)
        first.connect("changed", validate)
        second.connect("changed", validate)

    def _on_grub_off(self, _row):
        self._confirm(
            "Remove the Boot Menu Lock?", "Anyone at the keyboard will be able to change how the system starts.",
            "Remove the Lock",
            lambda: self._run_operation(["pkexec", ADMIN, "grub-lock-off"], title="Removing the Lock",
                                        working="Removing the boot menu password.", done="The boot menu is open"),
            destructive=True,
        )

    def _on_kernel_switch(self, _row):
        kernel = getattr(self, "_kernel", {})
        target = "cachyos" if kernel.get("follows_flavour") == "fedora" else "fedora"
        name = "the CachyOS kernel" if target == "cachyos" else "Fedora's kernel"
        body = (f"The version with {name} is downloaded now and starts at the next restart. Files, settings and apps stay. "
                "If the TPM unlocks the disk, the first start asks the passphrase once; then let the TPM in again from this page.")
        if target == "cachyos":
            body += " The CachyOS kernel needs a processor with x86-64-v3 and, with Secure Boot on, Lucciola's key registered."
        self._confirm(
            f"Switch to {name.capitalize() if target == 'fedora' else name}?", body, "Switch",
            lambda: self._run_operation(["pkexec", ADMIN, "kernel", target], title="Switching the Kernel",
                                        working=f"Downloading the version with {name}. This takes a few minutes.",
                                        done="Switched: restart to use the other kernel"),
        )

