        row.connect("activated", lambda *_: Gtk.UriLauncher.new(KDEC_DOWNLOAD).launch(self, None, None))
        more.add(row)
        info_row(more, "Mouse and Keyboard From the Phone", "input-mouse-symbolic", "Not available under niri yet: it needs a RemoteDesktop portal")
        row = Adw.ActionRow(title="KDE Connect's Own Settings", subtitle="Everything else, in KDE Connect's window")
