    # ═══════════════════════════════ Phone ══════════════════════════
    # KDE Connect's daemon over D-Bus: the devices it knows, their pairing,
    # battery, the functions per device, a ring, a file, ready-made
    # commands. The app on the phone does the rest.

    def _bus(self):
        if getattr(self, "_session_bus", None) is None:
            self._session_bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        return self._session_bus

    def _kdec_call(self, path, iface, method, params=None, timeout=15000):
        """One D-Bus call to the daemon; the unpacked reply, or None on any error."""
        try:
            reply = self._bus().call_sync(KDEC_BUS, path, iface, method, params, None,
                                          Gio.DBusCallFlags.NONE, timeout, None)
        except GLib.Error:
            return None
        return reply.unpack() if reply is not None else ()

    def _kdec_props(self, path, iface):
        """All properties of an interface, or {} when the object is not there."""
        reply = self._kdec_call(path, "org.freedesktop.DBus.Properties", "GetAll", GLib.Variant("(s)", (iface,)))
        return reply[0] if reply else {}

    def _build_phone(self):
        page = preferences_page()
