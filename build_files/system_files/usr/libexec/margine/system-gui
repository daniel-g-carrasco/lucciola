def run(argv, timeout=30, env=None, stdin=None):
    """Command runner that never raises: (returncode, stdout, stderr).
    -1 is a tool that could not start, -2 a timeout."""
    try:
        res = subprocess.run(argv, text=True, capture_output=True, timeout=timeout, env=env, input=stdin)
        return res.returncode, res.stdout, res.stderr
    except OSError as e:
        return -1, "", str(e)
    except subprocess.TimeoutExpired:
        return -2, "", "took too long"


def read_file(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def in_thread(fn, *args):
    GLib.Thread.new(None, lambda: fn(*args))


def on_main(fn, *args):
    GLib.idle_add(lambda: (fn(*args), False)[1])


def icon(name):
    return Gtk.Image.new_from_icon_name(name)


def spinner(size):
    s = Adw.Spinner()
    s.set_size_request(size, size)
    s.set_valign(Gtk.Align.CENTER)
    return s


def info_row(group, title, icon_name, subtitle=""):
    row = Adw.ActionRow(title=title, subtitle=subtitle)
    row.add_prefix(icon(icon_name))
    row.set_activatable(False)
    row.set_subtitle_selectable(True)
    group.add(row)
    return row


def button_row(group, title, icon_name, callback, css=None):
    row = Adw.ButtonRow(title=title)
    row.set_start_icon_name(icon_name)
    if css:
        row.add_css_class(css)
    row.connect("activated", callback)
    group.add(row)
    return row


def preferences_page():
    page = Adw.PreferencesPage()
    return page


class SystemWindow(Adw.ApplicationWindow):
