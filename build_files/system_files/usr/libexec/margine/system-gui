    def _on_autologin_toggled(self, switch, _pspec):
        if self._autologin_guard:
            return
        wanted = switch.get_active()
        # Put the switch back until the helper has done it; the refresh sets the real state.
        self._autologin_guard = True
        switch.set_active(not wanted)
        self._autologin_guard = False
        if wanted:
            self._confirm(
                "Log In Automatically?",
                "Whoever turns this machine on gets into your session, without a password or fingerprint. "
                "The keyring stays locked until an app asks for its password, unless the TPM opens it (see above).",
                "Log In Automatically",
                lambda: self._run_operation(["pkexec", ADMIN, "autologin-on"], title="Turning Automatic Login On",
                                            working="Writing the login screen's setting.", done="Automatic login from the next startup"),
                destructive=True,
            )
        else:
            self._run_operation(["pkexec", ADMIN, "autologin-off"], title="Turning Automatic Login Off",
                                working="Writing the login screen's setting.", done="The login screen asks again from the next startup")

