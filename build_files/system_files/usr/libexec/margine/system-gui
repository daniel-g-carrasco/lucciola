        self._phone_name_row.set_show_apply_button(True)
        self._phone_name_row.connect("apply", self._on_phone_name_apply)
        self._phone_pc.add(self._phone_name_row)
        self._phone_look_button = button_row(self._phone_pc, "Look for Devices Again", "view-refresh-symbolic", self._on_phone_look)

        self._phone_devices_group = Adw.PreferencesGroup(title="Devices")
        page.add(self._phone_devices_group)

        self._phone_usb_group = Adw.PreferencesGroup(
            title="Camera Over USB",
            description="A phone on the cable with USB debugging on can be the webcam with or without KDE Connect.",
        )
        page.add(self._phone_usb_group)
        self._phone_usb_group.set_visible(False)

        more = Adw.PreferencesGroup(title="More")
        page.add(more)
