    def _build_hardware(self):
        page = preferences_page()
        sched = Adw.PreferencesGroup(
            title="CPU Scheduler",
            description="The kernel's own scheduler suits most work. A sched_ext scheduler can favour games, audio or battery life; it applies at once and at every start, and the kernel's own is one click away.",
        )
        page.add(sched)
        self._sched_running_row = info_row(sched, "Running Now", "preferences-system-symbolic")
        self._sched_boot_row = info_row(sched, "At Startup", "system-reboot-symbolic")
        self._sched_mode_row = Adw.ComboRow(title="Mode", subtitle="Auto adapts; the others force a profile")
        self._sched_mode_row.set_model(Gtk.StringList.new([ls.SCHED_MODE_LABELS[m] for m, _ in ls.SCHED_MODES]))
        self._sched_mode_row.connect("notify::selected", lambda r, _p: setattr(self, "_sched_mode", r.get_selected()))
        sched.add(self._sched_mode_row)
        self._sched_choose_button = button_row(sched, "Choose a Scheduler…", "preferences-system-symbolic", self._on_choose_scheduler, "suggested-action")
        self._sched_off_button = button_row(sched, "Use the Kernel's Own Scheduler", "edit-undo-symbolic", self._on_scheduler_off)

        tools = Adw.PreferencesGroup(title="More Tools")
        page.add(tools)
        cam = Adw.ActionRow(title="Phone Camera", subtitle="Use an Android phone as a webcam")
        cam.add_prefix(icon("camera-web-symbolic"))
        cam.add_suffix(icon("go-next-symbolic"))
        cam.set_activatable(True)
        cam.connect("activated", lambda *_: self._launch_desktop("dev.margine.PhoneCam.desktop"))
        tools.add(cam)
        return page

    def _refresh_hardware(self):
        gen = self._bump("hardware")
        for row in (self._sched_running_row, self._sched_boot_row):
            self._set_loading(row, True)

        def worker():
            # Never scxctl here: asking it starts the scheduler service.
            _, enabled, _ = run(["systemctl", "is-enabled", SCX_SERVICE])
            _, active, _ = run(["systemctl", "is-active", SCX_SERVICE])
            st = ls.scheduler_state(read_file(SCX_STATE), read_file(SCX_OPS), read_file(SCX_CONFIG), enabled, active)
            on_main(self._set_scheduler, gen, st)

        in_thread(worker)

    def _set_scheduler(self, gen, st):
        if not self._current("hardware", gen):
            return
        self._sched = st
        self._set_loading(self._sched_running_row, False)
        self._set_loading(self._sched_boot_row, False)
        if st["running"]:
            self._sched_running_row.set_subtitle(f"scx_{st['running']}")
        else:
            self._sched_running_row.set_subtitle("The kernel's own scheduler")
        if st["default_sched"]:
            label = ls.SCHED_MODE_LABELS.get(st["default_mode"] or "Auto", st["default_mode"] or "Auto")
            self._sched_boot_row.set_subtitle(f"scx_{st['default_sched']}, {label} mode")
            idx = [m for m, _ in ls.SCHED_MODES].index(st["default_mode"]) if st["default_mode"] in dict(ls.SCHED_MODES) else 0
            self._sched_mode_row.set_selected(idx)
        elif st["config_present"]:
            self._sched_boot_row.set_subtitle("The kernel's own scheduler (a choice is saved but the service is off)")
        else:
            self._sched_boot_row.set_subtitle("The kernel's own scheduler")
        self._sched_off_button.set_sensitive((st["running"] or st["config_present"] or st["enabled"]) and not self._busy)
        self._sched_choose_button.set_sensitive(not self._busy)

    def _on_choose_scheduler(self, _row):
        self._sched_choose_button.set_sensitive(False)

        def worker():
            rc, out, err = run(["scxctl", "list"], timeout=30)
            names = []
            if rc == 0:
                import re
                names = re.findall(r'"([^"]+)"', out)
            on_main(self._show_schedulers, names, rc, err)

        in_thread(worker)

    def _show_schedulers(self, names, rc, err):
        self._sched_choose_button.set_sensitive(True)
        if rc != 0 or not names:
            self._toast("No scheduler is available on this machine" if rc == 0 else "Could not list the schedulers")
            return
        blurbs = {
            "lavd": "Latency-aware; the usual choice for games and desktops",
            "bpfland": "Interactive work and games; keeps the desktop smooth",
            "flash": "Audio and real-time work",
            "rusty": "Balanced multi-core",
            "cosmos": "General purpose, lightweight",
            "p2dq": "Simple and predictable",
            "tickless": "Fewer timer interrupts; battery and servers",
            "rustland": "Testing ground; not for daily use",
        }
        preferred = ["lavd", "bpfland", "flash", "rusty", "cosmos", "p2dq", "tickless", "rustland"]
        ordered = [n for n in preferred if n in names] + [n for n in names if n not in preferred]
        mode = ls.SCHED_MODES[self._sched_mode][0]
        page = preferences_page()
        group = Adw.PreferencesGroup(
            title="Schedulers",
            description=f"Each applies at once and at every start, in {ls.SCHED_MODE_LABELS[mode]} mode. The kernel's own scheduler is one click away afterwards.",
        )
        page.add(group)
        running = getattr(self, "_sched", {}).get("running")
        for name in ordered:
            row = Adw.ActionRow(title=f"scx_{name}", subtitle=blurbs.get(name, ""))
            row.add_prefix(icon("object-select-symbolic" if name == running else "preferences-system-symbolic"))
            button = Gtk.Button(label="Use", valign=Gtk.Align.CENTER)
            button.set_sensitive(name != running)
            button.connect("clicked", self._on_use_scheduler, name, mode)
            row.add_suffix(button)
            group.add(row)
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(page)
        self._sched_dialog = Adw.Dialog()
        self._sched_dialog.set_title("Choose a Scheduler")
        self._sched_dialog.set_content_width(520)
        self._sched_dialog.set_content_height(600)
        self._sched_dialog.set_child(toolbar)
        self._sched_dialog.present(self)

    def _on_use_scheduler(self, _button, name, mode):
        self._close_dialog("_sched_dialog")
        self._run_operation(
            ["pkexec", ADMIN, "scheduler", name, mode], title=f"Using scx_{name}",
            working=f"Starting scx_{name} in {ls.SCHED_MODE_LABELS[mode]} mode and making it the choice at startup.",
            done=f"scx_{name} is running and starts at every boot",
        )

    def _on_scheduler_off(self, _row):
        self._run_operation(
            ["pkexec", ADMIN, "scheduler-off"], title="Back to the Kernel's Scheduler",
            working="Stopping the sched_ext scheduler and its service.", done="The kernel's own scheduler is back",
        )

