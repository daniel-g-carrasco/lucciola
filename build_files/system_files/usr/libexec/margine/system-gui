    # ── pages: navigation ────────────────────────────────────────────

    def show_page(self, page_id):
        row = self._rows_by_page.get(page_id)
        if row is not None:
            self._sidebar.select_row(row)

    def _on_page_selected(self, _listbox, row):
        if row is None:
            return
        page_id = row.page_id
        self._current_page = page_id
        title = dict((p[0], p[1]) for p in PAGES)[page_id]
        self._stack.set_visible_child_name(page_id)
        self._content_title.set_title(title)
        self._content_page.set_title(title)
        self._split.set_show_content(True)
        self._refresh_page(page_id)

    def _refresh_page(self, page_id):
        if page_id == "overview":
            self._refresh_overview()
        elif page_id == "startup":
            self._refresh_startup()
        elif page_id == "login":
            self._refresh_login()
        elif page_id == "hardware":
            self._refresh_hardware()

    def _refresh_all(self):
        self._refresh_overview()
        if self._current_page != "overview":
            self._refresh_page(self._current_page)

    def _on_active_changed(self, *_args):
        if self.is_active() and time.monotonic() - self._last_refresh > REFRESH_ON_FOCUS:
            self._refresh_all()

    def _on_timer(self):
        if not self._busy:
            self._refresh_all()
        return True

    def _bump(self, page_id):
        """A refresh generation per page: results from an older refresh are dropped."""
        self._page_generation[page_id] = self._page_generation.get(page_id, 0) + 1
        return self._page_generation[page_id]

    def _current(self, page_id, gen):
        return self._page_generation.get(page_id) == gen

    # ── small helpers ────────────────────────────────────────────────

    def _link_row(self, group, title, icon_name, callback):
        row = Adw.ActionRow(title=title)
        row.add_prefix(icon(icon_name))
        row.add_suffix(icon("go-next-symbolic"))
        row.connect("activated", callback)
        self._set_loading(row, True)
        group.add(row)
        return row

    def _set_loading(self, row, loading):
        """A small spinner in place of the subtitle while a row waits."""
        current = getattr(row, "_spinner", None)
        if loading and current is None:
            row._spinner = spinner(16)
            row.add_suffix(row._spinner)
            row.set_subtitle("")
        elif not loading and current is not None:
            row.remove(current)
            row._spinner = None

    def _toast(self, message, button=None, action=None):
        toast = Adw.Toast.new(message)
        if button and action:
            toast.set_button_label(button)
            toast.set_action_name(action)
        self._toasts.add_toast(toast)

    def _confirm(self, heading, body, verb, on_confirm, destructive=False, extra=None):
        dialog = Adw.AlertDialog(heading=heading, body=body)
        if extra is not None:
            dialog.set_extra_child(extra)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", verb)
        dialog.set_response_appearance(
            "go", Adw.ResponseAppearance.DESTRUCTIVE if destructive else Adw.ResponseAppearance.SUGGESTED
        )
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r: r == "go" and on_confirm())
        dialog.present(self)
        return dialog

    def _list_dialog(self, title, description, items, empty, icon_name="package-x-generic-symbolic", extra=None):
        page = preferences_page()
        group = Adw.PreferencesGroup(title=title, description=description)
        page.add(group)
        if items:
            for item in items:
                name, subtitle = item if isinstance(item, tuple) else (item, "")
                row = Adw.ActionRow(title=name, subtitle=subtitle if subtitle != name else "")
                row.add_prefix(icon(icon_name))
                group.add(row)
        else:
            row = Adw.ActionRow(title=empty)
            row.add_prefix(icon("object-select-symbolic"))
            group.add(row)
        if extra is not None:
            for widget in extra:
                page.add(widget)
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(page)
        dialog = Adw.Dialog()
        dialog.set_title(title)
        dialog.set_content_width(480)
        dialog.set_content_height(560)
        dialog.set_child(toolbar)
        dialog.present(self)
        return dialog

