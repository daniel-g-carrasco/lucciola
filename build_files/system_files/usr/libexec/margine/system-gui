def run(argv, timeout=30, env=None, stdin=None):
    """Command runner that never raises: (returncode, stdout, stderr).
    -1 is a tool that could not start, -2 a timeout."""
    try:
        res = subprocess.run(argv, text=True, capture_output=True, timeout=timeout, env=env, input=stdin)
        return res.returncode, res.stdout, res.stderr
    except OSError as e:
        return -1, "", str(e)
    except subprocess.TimeoutExpired:
        return -2, "", "took too long"


def read_file(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def in_thread(fn, *args):
    GLib.Thread.new(None, lambda: fn(*args))


def on_main(fn, *args):
    GLib.idle_add(lambda: (fn(*args), False)[1])


