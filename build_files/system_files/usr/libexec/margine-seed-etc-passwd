#!/usr/bin/env python3
"""Seed /etc/passwd + /etc/group from the /usr/lib factory.

Two callers, one merge (deduplicated 2026-06-12 — the same logic used
to live twice, as a build-time heredoc in 10-os-identity and as this
boot script, hand-synced):

  - at image build: 10-os-identity runs `--force` after copying
    system_files, so the post-rechunk /usr/etc factory is complete
    (Bug 6: rechunk strips /etc/passwd when re-committing the tree);
  - at every boot: margine-seed-etc-passwd.service runs without
    --force, re-applying the seed only if /etc/passwd has fewer than
    20 entries (the post-rebase stripped state). Otherwise no-op.

Local /etc lines override factory ones for the same name, so a custom
root shell or a real user account is never clobbered.

Then, every time: an account or group the system knows (from /etc or from
the image's /usr/lib through nss-altfiles) that has no /etc/shadow or
/etc/gshadow line gets one, copied from the image's default in /usr/etc, or
locked when the image has none (2026-10-18). A machine with layered packages
gets its system accounts moved to /usr/lib/passwd by rpm-ostree, while its
own /etc/shadow survives the update without the new account's line;
systemd-sysusers then finds the account and writes nothing, PAM cannot look
it up ("unix_chkpwd: could not obtain user info"), and user@<uid>.service
failed for greetd after the move from margine:lucciola (upgrade-smoke).
Existing lines are never touched; missing ones are appended in place, which
keeps each file's mode, owner and SELinux label.
"""

import os
import sys
import time


def load(p):
    try:
        with open(p) as f:
            return [line.rstrip("\n") for line in f if line.strip()]
    except FileNotFoundError:
        return []


def by_name(lines):
    return {line.split(":", 1)[0]: line for line in lines}


force = "--force" in sys.argv[1:]

if not force:
    need_seed = False
    for kind in ("passwd", "group"):
        if len(load(f"/etc/{kind}")) < 20:
            need_seed = True
            break
    if not need_seed:
        print("/etc/passwd + /etc/group look populated, no seeding needed")
else:
    need_seed = True

for kind in ("passwd", "group") if need_seed else ():
    local = by_name(load(f"/etc/{kind}"))
    factory = by_name(load(f"/usr/lib/{kind}"))
    merged = dict(factory)
    merged.update(local)

    def k(line):
        try:
            u = int(line.split(":")[2])
            return (u >= 1000, u)
        except Exception:
            return (True, 999999)

    tmp = f"/etc/{kind}.new"
    with open(tmp, "w") as f:
        for line in sorted(merged.values(), key=k):
            f.write(line + "\n")
    os.replace(tmp, f"/etc/{kind}")
    print(f"/etc/{kind}: was {len(local)} → now {len(merged)} (+{len(merged) - len(local)} from factory)")


def add_missing_shadow(table, shadow, fallback):
    """Append the missing /etc/<shadow> line of every account (or group) the
    system knows, from /etc/<table> or the image's /usr/lib/<table>
    (nss-altfiles). The line comes from the image's own default,
    /usr/etc/<shadow>, when it has one; a shadowed /etc/<table> entry the
    image does not know gets a locked line from `fallback`."""
    path = f"/etc/{shadow}"
    if not os.path.exists(path):
        return
    have = by_name(load(path))
    image = by_name(load(f"/usr/etc/{shadow}"))
    missing = []
    seen = set()
    for source in (f"/etc/{table}", f"/usr/lib/{table}"):
        for line in load(source):
            fields = line.split(":")
            name = fields[0]
            if len(fields) < 2 or name in have or name in seen:
                continue
            seen.add(name)
            if name in image:
                missing.append(image[name])
            elif source.startswith("/etc/") and fields[1] == "x":
                missing.append(fallback(fields))
    if not missing:
        return
    with open(path, "a") as f:
        f.write("".join(m + "\n" for m in missing))
    names = ", ".join(m.split(":", 1)[0] for m in missing)
    print(f"/etc/{shadow}: added entries for {names}")


today = int(time.time() // 86400)
add_missing_shadow("passwd", "shadow", lambda f: f"{f[0]}:!*:{today}::::::")
add_missing_shadow("group", "gshadow", lambda f: f"{f[0]}:!::{f[3] if len(f) > 3 else ''}")
