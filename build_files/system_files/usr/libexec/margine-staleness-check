#!/usr/bin/env python3
"""Notify user if ghcr.io/.../lucciola:stable hasn't been refreshed
in >7 days. Either the build pipeline is broken, or upstream has
genuinely paused — either way the user should know."""

import json
import subprocess
import sys
from datetime import datetime, timezone

WARN_AGE_DAYS = 7
CRIT_AGE_DAYS = 14


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=30)


# Get current booted image reference
# Read-only rpm-ostree status works for the session user and with layers;
# bootc status may require root, making a user timer silently do nothing.
r = run(["rpm-ostree", "status", "--booted", "--json"])
if r.returncode != 0:
    sys.exit(0)
try:
    deployments = json.loads(r.stdout).get("deployments", [])
    booted = next((d for d in deployments if d.get("booted")), {})
    origin = booted.get("container-image-reference") or ""
except (ValueError, TypeError):
    sys.exit(0)
image_ref = origin.partition(":")[2].removeprefix("docker://")
if not image_ref.startswith("ghcr.io/daniel-g-carrasco/lucciola:") or "@" in image_ref:
    sys.exit(0)  # another image or a deliberate digest pin

# Inspect upstream :stable to find its creation timestamp
r = run(["skopeo", "inspect", "--no-tags", f"docker://{image_ref}"])
if r.returncode != 0:
    sys.exit(0)  # network down? skip silently this round
created = json.loads(r.stdout)["Created"]  # ISO 8601, UTC

# fromisoformat handles optional fractional seconds; the old
# strptime(created.split(".")[0]) raised on no-fraction stamps (the
# trailing Z survived the split) and mktime read UTC as local time.
try:
    created_dt = datetime.fromisoformat(created.replace("Z", "+00:00"))
except ValueError:
    sys.exit(0)
age_days = (datetime.now(timezone.utc) - created_dt).total_seconds() / 86400

if age_days < WARN_AGE_DAYS:
    sys.exit(0)

urgency = "critical" if age_days >= CRIT_AGE_DAYS else "normal"
title = "Lucciola: upstream stale"
# The tag this machine follows (:stable, or :fedora-kernel on the kernel
# reserve, which is rebuilt with every :stable).
tag = image_ref.rpartition(":")[2] if "@" not in image_ref else "stable"
body = f"Latest :{tag} is {age_days:.0f} days old. Build pipeline may be broken."
# margine-notify, not notify-send: it fills the fdo app_icon field so
# the logo also shows on the lock screen (docs/BRANDING.md).
subprocess.run(
    ["/usr/libexec/margine/margine-notify", "-u", urgency, title, body]
)
