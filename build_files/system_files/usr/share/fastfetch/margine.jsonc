{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/margine/ascii-logo.txt",
    "type": "file",
    "color": { "1": "#e6d5bf", "2": "#c2a180", "3": "#6f5d4b", "4": "#ece6df" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": " · ",
    "color": { "keys": "#c2a180", "title": "#e6d5bf" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "locale",
    "break",
    "colors"
  ]
}
