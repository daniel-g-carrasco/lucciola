[Desktop Entry]
Type=Application
Name=Lucciola CPU Scheduler
GenericName=CPU scheduler
Comment=Choose a sched_ext CPU scheduler, or stay with the kernel's own. Opens the Hardware page of Lucciola System.
Exec=/usr/libexec/margine/system-gui --page hardware
Icon=margine-scheduler
Terminal=false
Categories=System;
Keywords=scheduler;sched_ext;scx;cpu;performance;latency;
StartupNotify=true
# The page lives in Lucciola System, whose window carries that app id.
StartupWMClass=dev.margine.System
