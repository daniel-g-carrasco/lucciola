#!/usr/bin/bash
# lucciola-autologin: enable/disable/inspect autologin on the login screen.
#
# Lucciola's login screen is greetd (with Noctalia Greeter): autologin is
# greetd's [initial_session] in /etc/greetd/config.toml, a session greetd
# starts once per boot without asking for a password. This script writes and
# removes that section only, keeping every other line and comment. It also
# mirrors the choice into GDM's /etc/gdm/custom.conf ([daemon]
# AutomaticLoginEnable / AutomaticLogin): GDM stays installed as the login
# screen greetd falls back to when it cannot start, and as the one a user can
# switch back to, and it should behave the same. Until 2026-10 this script
# edited GDM's file alone; a system whose display manager is GDM again
# (`systemctl enable --force gdm.service`) is still handled that way.
#
#   lucciola-autologin            # = status: print ENABLED (user) or disabled
#   lucciola-autologin status     # same, no mutation
#   lucciola-autologin on [USER]  # enable autologin for USER (idempotent)
#   lucciola-autologin off        # disable autologin (idempotent)
#
# Run via `ujust lucciola-autologin ...`. 'status' is read-only and needs no
# privilege; 'on'/'off' mutate /etc and re-exec themselves under sudo.
#
# The two files change together or not at all: both are written in full to
# temporary files next to them first, and only when both are ready do they
# replace the originals (a rename each). If the second rename fails the first
# is put back, so a failed command leaves the machine as it was and says so.
#
# The paths can be pointed elsewhere for tests (tests/lucciola-autologin.test.sh):
# MARGINE_AUTOLOGIN_GREETD_CONF, MARGINE_AUTOLOGIN_GDM_CONF, and
# MARGINE_AUTOLOGIN_DM (the display manager unit, normally read from
# /etc/systemd/system/display-manager.service).
set -euo pipefail

GREETD_CONF="${MARGINE_AUTOLOGIN_GREETD_CONF:-/etc/greetd/config.toml}"
GDM_CONF="${MARGINE_AUTOLOGIN_GDM_CONF:-/etc/gdm/custom.conf}"
SELF="lucciola-autologin"
# What greetd runs as the autologin session. The launcher starts the session
# recorded for the user in AccountsService (Lucciola unless changed), as
# GDM's autologin did, with the session environment a greeter would pass.
# .github/scripts/inject-gui-probe.sh writes the same line for the CI smoke
# user: keep the two in step.
AUTOLOGIN_CMD="/usr/libexec/lucciola/autologin-session"

die() { printf '%s: %s\n' "$SELF" "$*" >&2; exit 1; }

# Which login screen this machine runs: greetd (Lucciola's), gdm, or other.
display_manager() {
  local unit="${MARGINE_AUTOLOGIN_DM:-}"
  if [ -z "$unit" ]; then
    unit="$(readlink /etc/systemd/system/display-manager.service 2>/dev/null || true)"
    unit="${unit##*/}"
  fi
  case "$unit" in
    greetd.service) echo greetd ;;
    gdm.service)    echo gdm ;;
    "")             echo none ;;
    *)              echo "$unit" ;;
  esac
}

# Escalate the mutating actions. Called only for 'on'/'off', BEFORE any write,
# so a non-root invocation re-runs the whole command as root via sudo rather
# than failing. Keeps the recipe a single sudo-free line (status never prompts)
# while still guaranteeing every write happens as root.
require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
      # Re-exec the exact action+args under root. ${USER_ARG:+ "$USER_ARG"}
      # passes the user only when one was given, so 'off' (and arg-less 'on')
      # don't append a stray empty argument.
      exec sudo -- "$0" "$ACTION" ${USER_ARG:+ "$USER_ARG"}
    fi
    die "must run as root. Use:  ujust ${SELF} ${ACTION}${USER_ARG:+ $USER_ARG}"
  fi
}

# The single gate every autologin target must clear, regardless of how it was
# chosen (explicit arg, $SUDO_USER, or the passwd fallback). A valid target
# must EXIST, have a uid in [1000,65534) (which also excludes root, uid 0,
# every system/service account (uid < 1000), and nobody/overflow (>= 65534))
# and have a genuine interactive login shell (not *nologin / *false / empty).
# Autologin only makes sense for a real human desktop account; a system
# account would fail the PAM session loop or silently configure a meaningless,
# unsafe autologin target. This subsumes the existence and "not root" checks.
validate_real_user() {
  local u="$1" uid shell
  uid="$(id -u "$u" 2>/dev/null)" \
    || die "user '$u' does not exist."
  { [ "$uid" -ge 1000 ] && [ "$uid" -lt 65534 ]; } \
    || die "refusing autologin for '$u' (uid $uid is not a normal user account)."
  shell="$(getent passwd "$u" | cut -d: -f7)"
  case "$shell" in
    *nologin|*false|"")
      die "refusing autologin for '$u' (no real login shell: '${shell}')." ;;
  esac
}

# Resolve the target user for `on`:
#   explicit arg  >  $SUDO_USER (unless 'root')  >  first real local account.
# This function only PICKS a candidate name; on its own it guarantees nothing
# about that name. The caller MUST run validate_real_user on the result before
# writing it: that gate (exists, uid in [1000,65534), genuine login shell,
# not root) is applied uniformly to all three resolution paths below.
resolve_user() {
  local u="$1"
  if [ -z "$u" ]; then
    if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
      u="${SUDO_USER}"
    else
      # First passwd entry with a normal uid range and a real login shell.
      # (validate_real_user re-checks this; the filter only keeps the default
      # candidate sensible so a "could not determine" message is accurate.)
      u="$(getent passwd | awk -F: '
        $3 >= 1000 && $3 < 65534 \
          && $7 != "" \
          && $7 !~ /(nologin|false)$/ { print $1; exit }' || true)"
    fi
  fi
  [ -n "$u" ] || die "could not determine a user to enable autologin for. Pass one explicitly:  ujust ${SELF} on <user>"
  printf '%s' "$u"
}

# Restore the SELinux label on a file. Run UNCONDITIONALLY after every write:
# a renamed temporary file keeps the context it was created with, which is
# wrong if the directory, or a file it replaced, arrived mislabelled (e.g. restored from a backup disk and
# carrying user_home_t). greetd and GDM both run as xdm_t and read xdm_etc_t
# (the policy default for /etc/greetd and /etc/gdm/custom.conf), so a stale
# label can make the login screen silently ignore the change, or break
# login. restorecon resets it; it is a no-op on an already-correct file.
# -F forces customizable types too.
relabel() {
  command -v restorecon >/dev/null 2>&1 || return 0
  restorecon -F -- "$1" 2>/dev/null || true
}

# Timestamped backup before any write (only if the file already exists). The
# backup is relabelled too: cp -a copies the SOURCE context, so a mislabelled
# file would otherwise spawn mislabelled backups forever: harmless to the
# login screen (it never reads them) but tidy to keep at the policy default.
backup() {
  [ -f "$1" ] || return 0
  local bak
  bak="${1}.margine.bak.$(date +%Y%m%d-%H%M%S-%N)"
  cp -a -- "$1" "$bak" || return 1
  relabel "$bak"
  printf '%s: backed up %s -> %s\n' "$SELF" "$1" "$bak"
}

# greetd's config: drop [initial_session] (every line from its header to the
# next section) and, for `on`, append a fresh one with USER. Every other line
# stays byte for byte. The result must parse as TOML (greetd's own parser
# reads the same subset) and say what was asked, or nothing is written.
# The new config goes to OUT (a staged file, see stage), never to the original.
# Args: OUT on USER | OUT off
set_initial_session() {
  local out="$1"; shift
  CONF="$GREETD_CONF" CMD="$AUTOLOGIN_CMD" OUT="$out" python3 - "$@" <<'PY'
import json, os, re, sys, tomllib

conf, cmd = os.environ["CONF"], os.environ["CMD"]
action = sys.argv[1]
user = sys.argv[2] if len(sys.argv) > 2 else ""
try:
    with open(conf, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
except FileNotFoundError:
    sys.exit(f"{conf} does not exist: greetd is not set up on this system")

header = re.compile(r"^\s*\[\s*([A-Za-z0-9_.-]+)\s*\]\s*(#.*)?$")
out, skipping = [], False
for line in lines:
    m = header.match(line)
    if m:
        skipping = m.group(1) == "initial_session"
    if not skipping:
        out.append(line)
while out and not out[-1].strip():
    out.pop()
if action == "on":
    out += [
        "",
        "[initial_session]",
        "# Autologin, set by `ujust lucciola-autologin on`: greetd starts this",
        "# user's session at boot, once per boot, without asking for a password.",
        f"command = {json.dumps(cmd)}",
        f"user = {json.dumps(user)}",
    ]
text = "\n".join(out) + "\n"
parsed = tomllib.loads(text)
if "default_session" not in parsed:
    sys.exit(f"{conf} has no [default_session]: refusing to write a config greetd cannot start")
got = parsed.get("initial_session", {}).get("user")
if (action == "on" and got != user) or (action == "off" and got is not None):
    sys.exit(f"internal error: the rewritten {conf} would not say what was asked")
with open(os.environ["OUT"], "w", encoding="utf-8") as fh:
    fh.write(text)
    fh.flush()
    os.fsync(fh.fileno())
PY
}

# Who greetd autologs in: the [initial_session] user, empty when none.
greetd_user() {
  CONF="$GREETD_CONF" python3 - <<'PY'
import os, tomllib
try:
    with open(os.environ["CONF"], "rb") as fh:
        print(tomllib.load(fh).get("initial_session", {}).get("user", ""))
except (OSError, tomllib.TOMLDecodeError):
    print("")
PY
}

# Line-aware INI editor for GDM's custom.conf. Sets keys ONLY inside
# [daemon], creating the section (and the file) if absent, updating existing
# keys in place, and leaving every other section/key/comment byte-for-byte.
# Re-runs never duplicate a key. The result goes to OUT, as above.
# Args: OUT KEY1 VAL1 [KEY2 VAL2 …]   (each key set under [daemon]).
set_daemon_keys() {
  local out="$1"; shift
  CONF="$GDM_CONF" OUT="$out" python3 - "$@" <<'PY'
import os, sys

conf = os.environ["CONF"]
pairs = sys.argv[1:]
wanted = {pairs[i]: pairs[i + 1] for i in range(0, len(pairs), 2)}

try:
    with open(conf, "r", encoding="utf-8-sig") as fh:
        lines = fh.read().splitlines()
except FileNotFoundError:
    lines = []

def header(line):
    s = line.strip()
    return s.startswith("[") and s.endswith("]")

out = []
in_daemon = False
seen = set()          # keys already updated inside [daemon]
daemon_found = False
i = 0
while i < len(lines):
    line = lines[i]
    if header(line):
        # Leaving a section: if it was [daemon], flush any keys not yet seen
        # right before the next header so they stay inside [daemon].
        if in_daemon:
            for k, v in wanted.items():
                if k not in seen:
                    out.append("%s=%s" % (k, v))
                    seen.add(k)
        in_daemon = (line.strip() == "[daemon]")
        if in_daemon:
            daemon_found = True
        out.append(line)
        i += 1
        # Tidy placement: if this [daemon] holds no key we intend to set,
        # emit the wanted keys immediately after the header (before any
        # trailing blank line) instead of letting the end-of-section flush
        # drop them after the blanks. Existing matching keys, if any, are
        # still updated in place by the loop below.
        if in_daemon:
            existing = []
            j = i
            while j < len(lines) and not header(lines[j]):
                sj = lines[j].strip()
                if sj and not sj.startswith(("#", ";")) and "=" in sj:
                    existing.append(sj.split("=", 1)[0].strip())
                j += 1
            if not any(k in wanted for k in existing):
                for k, v in wanted.items():
                    if k not in seen:   # guard: a 2nd [daemon] must not re-emit
                        out.append("%s=%s" % (k, v))
                        seen.add(k)
        continue

    if in_daemon:
        stripped = line.strip()
        if stripped and not stripped.startswith(("#", ";")) and "=" in stripped:
            key = stripped.split("=", 1)[0].strip()
            if key in wanted:
                if key not in seen:
                    out.append("%s=%s" % (key, wanted[key]))
                    seen.add(key)
                i += 1
                continue
    out.append(line)
    i += 1

# File (or last section) ended while still inside [daemon]: flush remainder.
if in_daemon:
    for k, v in wanted.items():
        if k not in seen:
            out.append("%s=%s" % (k, v))
            seen.add(k)

# No [daemon] section existed anywhere: append a fresh one.
if not daemon_found:
    if out and out[-1].strip() != "":
        out.append("")
    out.append("[daemon]")
    for k, v in wanted.items():
        out.append("%s=%s" % (k, v))

with open(os.environ["OUT"], "w", encoding="utf-8") as fh:
    fh.write("\n".join(out) + "\n")
    fh.flush()
    os.fsync(fh.fileno())
PY
}

# GDM's state from the [daemon] section.
# Prints:  "<enabled-bool> <login-user>"  (either field may be empty).
gdm_state() {
  CONF="$GDM_CONF" python3 - <<'PY'
import os
conf = os.environ["CONF"]
try:
    with open(conf, "r", encoding="utf-8-sig") as fh:
        lines = fh.read().splitlines()
except FileNotFoundError:
    print(" ")
    raise SystemExit(0)

in_daemon = False
enabled = ""
user = ""
for line in lines:
    s = line.strip()
    if s.startswith("[") and s.endswith("]"):
        in_daemon = (s == "[daemon]")
        continue
    if not in_daemon or not s or s.startswith(("#", ";")) or "=" not in s:
        continue
    k, v = s.split("=", 1)
    k = k.strip(); v = v.strip()
    if k == "AutomaticLoginEnable":
        enabled = v
    elif k == "AutomaticLogin":
        user = v
print("%s %s" % (enabled, user))
PY
}

# The GDM side of on/off is the whole job on a GDM system, a mirror otherwise.
# On a greetd system a missing /etc/gdm is left alone (nothing to mirror).
gdm_mirrored() {
  [ "$DM" = gdm ] || [ -d "$(dirname "$GDM_CONF")" ]
}

# --- The transaction --------------------------------------------------------
# stage DEST: an empty temporary file in DEST's directory (so the final rename
# stays on one filesystem and is atomic), with DEST's owner and mode, or 0644
# for a new file. Its path goes to $STAGED_FILE (not printed: a command
# substitution would lose the cleanup list). Staged files and the rollback
# links below are removed on exit, whatever happens.
STAGED=()
cleanup() {
  local f
  for f in "${STAGED[@]}"; do rm -f -- "$f"; done
}
trap cleanup EXIT
stage() {
  local dest="$1" tmp
  STAGED_FILE=""
  tmp="$(mktemp -- "$(dirname "$dest")/.$(basename "$dest").lucciola.XXXXXX")" || return 1
  STAGED+=("$tmp")
  if [ -e "$dest" ]; then
    { chmod --reference="$dest" -- "$tmp" && chown --reference="$dest" -- "$tmp"; } || return 1
  else
    chmod 0644 -- "$tmp" || return 1
  fi
  STAGED_FILE="$tmp"
}

# commit TMP DEST [TMP DEST]: rename each staged file over its destination, in
# the order given. Before the first rename every existing destination gets a
# hard link next to it (the old file, same inode, same label); if a rename
# fails, the destinations already replaced get their old file back (or are
# removed if there was none), and commit fails. Callers pass the file that
# removes a password LAST, so that even a power cut between the two renames
# never leaves the active login screen less protected than asked.
commit() {
  local -a tmps=() dests=() keeps=()
  local i n dest keep
  while (( $# >= 2 )); do tmps+=("$1"); dests+=("$2"); shift 2; done
  n=${#dests[@]}
  for (( i = 0; i < n; i++ )); do
    dest="${dests[i]}" keep=""
    if [ -e "$dest" ]; then
      keep="$(dirname "$dest")/.$(basename "$dest").lucciola-rollback"
      STAGED+=("$keep")
      ln -f -- "$dest" "$keep" || return 1
    fi
    keeps+=("$keep")
  done
  for (( i = 0; i < n; i++ )); do
    if ! mv -f -T -- "${tmps[i]}" "${dests[i]}"; then
      local j ok=1
      for (( j = i - 1; j >= 0; j-- )); do
        if [ -n "${keeps[j]}" ]; then
          mv -f -T -- "${keeps[j]}" "${dests[j]}" || ok=0
        else
          rm -f -- "${dests[j]}" || ok=0
        fi
      done
      if (( ok )); then
        printf '%s: could not replace %s: nothing was changed.\n' "$SELF" "${dests[i]}" >&2
      else
        printf '%s: could not replace %s, and could not put back %s: the two login screens disagree now. Run the same command again, or restore the backups printed above.\n' \
          "$SELF" "${dests[i]}" "${dests[*]:0:i}" >&2
      fi
      return 1
    fi
    relabel "${dests[i]}"
  done
  # Make the renames durable before reporting success.
  for (( i = 0; i < n; i++ )); do sync -- "$(dirname "${dests[i]}")" 2>/dev/null || true; done
}

ACTION="${1:-status}"
USER_ARG="${2:-}"
DM="$(display_manager)"

case "$ACTION" in
  status|"")
    if [ "$DM" = gdm ]; then
      state="$(gdm_state)"
      enabled="${state%% *}"
      login_user="${state#* }"
      # Case-insensitive truthy match for the GDM boolean.
      shopt -s nocasematch
      if [[ "$enabled" == "true" ]] && [ -n "$login_user" ]; then
        shopt -u nocasematch
        printf 'autologin: ENABLED for user "%s" (login screen: GDM)\n' "$login_user"
      else
        shopt -u nocasematch
        printf 'autologin: disabled (login screen: GDM)\n'
      fi
    else
      login_user="$(greetd_user)"
      if [ -n "$login_user" ]; then
        printf 'autologin: ENABLED for user "%s"\n' "$login_user"
      else
        printf 'autologin: disabled\n'
      fi
      [ "$DM" = greetd ] || printf '%s: note: the display manager is %s, not greetd: this setting applies when greetd is the login screen.\n' "$SELF" "$DM"
    fi
    ;;

  on)
    require_root
    target="$(resolve_user "$USER_ARG")"
    # ONE gate for every resolution path (explicit arg, $SUDO_USER, fallback):
    # rejects root, system/service accounts (uid<1000), nobody/overflow
    # (uid>=65534), nologin/false shells, and non-existent users, closing the
    # system-account / nobody autologin hole. Nothing is written until this
    # passes, so a bogus target never reaches the configuration.
    validate_real_user "$target"
    # Stage everything first: any failure here changes nothing.
    pending=()
    if gdm_mirrored; then
      { stage "$GDM_CONF" && g="$STAGED_FILE" && set_daemon_keys "$g" AutomaticLoginEnable True AutomaticLogin "$target"; } \
        || die "could not prepare $GDM_CONF: nothing was changed"
      pending+=("$g" "$GDM_CONF")
    fi
    if [ "$DM" != gdm ]; then
      { stage "$GREETD_CONF" && t="$STAGED_FILE" && set_initial_session "$t" on "$target"; } \
        || die "could not prepare $GREETD_CONF: nothing was changed"
      # greetd last: it is the login screen that will skip the password.
      pending+=("$t" "$GREETD_CONF")
    fi
    for (( k = 1; k < ${#pending[@]}; k += 2 )); do
      backup "${pending[k]}" || die "could not back up ${pending[k]}: nothing was changed"
    done
    commit "${pending[@]}" || exit 1
    printf '%s: autologin ENABLED for "%s".\n' "$SELF" "$target"
    printf '%s: SECURITY: this machine will boot straight to "%s"'\''s desktop with NO password.\n' "$SELF" "$target"
    if [ "$DM" != gdm ]; then
      printf '%s: the saved passwords stay locked until unlocked once: for them to open at boot too, run (as "%s"): ujust lucciola-keyring tpm\n' "$SELF" "$target"
    fi
    printf '%s: takes effect at the next reboot.\n' "$SELF"
    ;;

  off)
    require_root
    pending=()
    if [ "$DM" != gdm ]; then
      if [ -f "$GREETD_CONF" ]; then
        { stage "$GREETD_CONF" && t="$STAGED_FILE" && set_initial_session "$t" off; } \
          || die "could not prepare $GREETD_CONF: nothing was changed"
        # greetd first: it is the login screen that would skip the password.
        pending+=("$t" "$GREETD_CONF")
      else
        printf '%s: %s does not exist: nothing to disable there.\n' "$SELF" "$GREETD_CONF"
      fi
    fi
    if [ -f "$GDM_CONF" ] && gdm_mirrored; then
      # Keep it minimal + reversible: flip the enable flag to False and leave
      # the remembered AutomaticLogin user in place. Other sections/keys are
      # untouched.
      { stage "$GDM_CONF" && g="$STAGED_FILE" && set_daemon_keys "$g" AutomaticLoginEnable False; } \
        || die "could not prepare $GDM_CONF: nothing was changed"
      pending+=("$g" "$GDM_CONF")
    elif [ "$DM" = gdm ]; then
      printf '%s: %s does not exist: autologin already disabled.\n' "$SELF" "$GDM_CONF"
    fi
    for (( k = 1; k < ${#pending[@]}; k += 2 )); do
      backup "${pending[k]}" || die "could not back up ${pending[k]}: nothing was changed"
    done
    (( ${#pending[@]} == 0 )) || commit "${pending[@]}" || exit 1
    printf '%s: autologin disabled.\n' "$SELF"
    printf '%s: takes effect at the next reboot.\n' "$SELF"
    ;;

  -h|--help|help)
    cat <<EOF
${SELF}: enable/disable/inspect autologin on the login screen.

Edits greetd's ${GREETD_CONF} ([initial_session]) and mirrors the choice
into GDM's ${GDM_CONF} (the fallback login screen); on a system whose
login screen is GDM again, edits GDM's file alone.

Usage:
  ujust ${SELF}              show current state (default, read-only)
  ujust ${SELF} status       show current state
  ujust ${SELF} on [user]    enable autologin (defaults to your account)
  ujust ${SELF} off          disable autologin

'on'/'off' re-exec under sudo if not already root.
'on' only accepts a real human account (uid in [1000,65534) with a genuine
login shell); root, system/service accounts, and nobody are refused.
The autologin session is the one recorded for the user (Lucciola unless
changed). Takes effect at the next reboot.
EOF
    ;;

  *)
    die "unknown action '$ACTION'. Try:  ujust ${SELF} [status|on|off]"
    ;;
esac
